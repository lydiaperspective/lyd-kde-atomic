<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.10"/>
  <requires lib="AnacondaWidgets" version="1.0"/>
  <object class="AnacondaSpokeWindow" id="editionSpokeWindow">
    <property name="can-focus">False</property>
    <property name="window-name" translatable="yes">LYD ATOMIC EDITION</property>
    <signal name="button-clicked" handler="on_back_clicked" swapped="no"/>
    <signal name="info-bar-clicked" handler="on_info_bar_clicked" swapped="no"/>
    <child internal-child="main_box">
      <object class="GtkBox" id="AnacondaSpokeWindow-main_box1">
        <property name="can-focus">False</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child internal-child="nav_box">
          <object class="GtkEventBox" id="AnacondaSpokeWindow-nav_box1">
            <property name="can-focus">False</property>
            <child internal-child="nav_area">
              <object class="GtkGrid" id="AnacondaSpokeWindow-nav_area1">
                <property name="can-focus">False</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
            <property name="position">0</property>
          </packing>
        </child>
        <child internal-child="alignment">
          <object class="GtkAlignment" id="AnacondaSpokeWindow-alignment1">
            <property name="can-focus">False</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <property name="xalign">0</property>
            <property name="yalign">0</property>
            <child internal-child="action_area">
              <object class="GtkBox" id="editionSpokeWindow-action_area1">
                <property name="can-focus">False</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">18</property>
                <property name="margin-start">32</property>
                <property name="margin-end">32</property>
                <property name="margin-top">32</property>
                <property name="margin-bottom">32</property>
                <child>
                  <object class="GtkLabel" id="editionHeading">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label">Choose your Lyd Atomic edition</property>
                    <property name="xalign">0</property>
                    <attributes>
                      <attribute name="weight" value="bold"/>
                      <attribute name="scale" value="1.35"/>
                    </attributes>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="editionDescription">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label">Select the system you want installed. The installer downloads only this edition from GitHub Container Registry, so an internet connection is required.</property>
                    <property name="wrap">True</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkComboBoxText" id="editionSelector">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="hexpand">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="editionDetails">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label">KDE Workstation: Standard graphics, virtualization, development tools and the Mystical theme. Includes printing/scanning, Waterfox and SyncThingy.
NVIDIA Gaming Workstation: Proprietary NVIDIA 580 driver, Steam, GameMode, MangoHud, Gamescope, Lutris, Heroic, ProtonPlus, virtualization, development tools and the Mystical theme.
Steam Deck: Bazzite Deck based handheld image with Steam Gaming Mode (Gamescope) and Deck hardware support.
Server: Headless Fedora bootc server with Podman, Cockpit and KVM/libvirt.
HTPC: Lightweight Plasma Bigscreen living-room interface with first-user autologin, controller navigation, Jellyfin Desktop, Finamp, Spotify and FCast Receiver. Includes legacy Intel VA-API support for older integrated graphics.</property>
                    <property name="wrap">True</property>
                    <property name="xalign">0</property>
                    <property name="yalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="editionNetworkWarning">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label">Important: keep the computer connected to the internet throughout installation. The selected image is not bundled on this ISO.</property>
                    <property name="wrap">True</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
