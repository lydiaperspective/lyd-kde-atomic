FROM quay.io/fedora/fedora-bootc:45

RUN dnf5 install -y \
    anaconda \
    anaconda-tui \
    anaconda-install-img-deps \
    anaconda-dracut \
    anaconda-widgets \
    dracut-config-generic \
    dracut-network \
    net-tools \
    grub2-efi-x64-cdboot \
    plymouth \
    plymouth-plugin-script \
    plymouth-scripts \
    grub2-tools \
    grub2-tools-extra \
    librsvg2-tools \
    xcursorgen \
    git \
    default-fonts-core-sans \
    default-fonts-other-sans \
    google-noto-sans-cjk-fonts \
    xorrisofs \
    squashfs-tools \
    jq \
    && dnf5 clean all

RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# Pull the same pinned Mystical theme revision used by the installed images.
RUN git clone --quiet --filter=blob:none https://github.com/lydiaperspective/lyd-kde-themes.git /tmp/lyd-kde-themes && \
    git -C /tmp/lyd-kde-themes checkout --quiet 462de0cb6bf0a1cddabbe95f5d547f4ec44e7024 && \
    bash /tmp/lyd-kde-themes/scripts/install-mystical-boot-assets.sh && \
    plymouth-set-default-theme lyd-mystical && \
    install -d /etc/default && \
    { grep -v '^GRUB_THEME=' /etc/default/grub 2>/dev/null || true; } > /tmp/grub-defaults && \
    printf 'GRUB_THEME="/usr/share/grub/themes/lyd-mystical/theme.txt"\nGRUB_TIMEOUT=5\nGRUB_TIMEOUT_STYLE=menu\n' >> /tmp/grub-defaults && \
    cat /tmp/grub-defaults > /etc/default/grub && \
    rm -rf /tmp/lyd-kde-themes /tmp/grub-defaults

RUN mkdir -p /usr/lib/image-builder/bootc
COPY installer/iso.yaml /usr/lib/image-builder/bootc/iso.yaml

RUN mkdir -p /usr/share/anaconda
COPY installer/interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks

COPY installer/addon/com_lyd_atomic_edition /usr/share/anaconda/addons/com_lyd_atomic_edition

RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root

RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /usr/share/dnf5/repos.d /etc/anaconda.repos.d && \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

RUN ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service
RUN mkdir -p /usr/lib/systemd/logind.conf.d
COPY installer/anaconda-shell.conf /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

RUN mkdir -p "$(realpath /root)" && \
    kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version' | head -n1) && \
    test -n "$kernel" && \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
      --add anaconda "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d && \
    printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.service.d/allowroot.conf && \
    printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.socket.d/allowroot.conf
