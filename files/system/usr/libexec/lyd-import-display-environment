#!/usr/bin/env bash
set -Eeuo pipefail

# Wayland sessions may export DISPLAY as an empty string. GPGME interprets
# that as an invalid X11 display argument and Flatpak signature verification
# fails with "GnuPG: General error".
if [[ -z "${DISPLAY:-}" ]]; then
  unset DISPLAY
  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd --unset=DISPLAY >/dev/null 2>&1 || true
  fi
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user unset-environment DISPLAY >/dev/null 2>&1 || true
  fi
elif command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd DISPLAY >/dev/null 2>&1 || true
fi
