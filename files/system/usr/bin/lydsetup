#!/usr/bin/env bash
# Lyd Atomic service and firewall setup helper.
set -Eeuo pipefail

VERSION="1.4.1"

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
need_user() { [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."; }
need_sudo() {
  command -v sudo >/dev/null 2>&1 || die "sudo is required."
}
need_firewalld() {
  command -v firewall-cmd >/dev/null 2>&1 || die "firewall-cmd is not installed."
  sudo firewall-cmd --state >/dev/null 2>&1 || die "firewalld is not running."
}
valid_zone() {
  local requested="$1" zone
  for zone in $(sudo firewall-cmd --permanent --get-zones); do
    [[ "$zone" == "$requested" ]] && { printf '%s' "$requested"; return 0; }
  done

  # Accept an interface name (for example tailscale0) and resolve its
  # permanent firewalld zone. An interface must already be assigned to a zone.
  zone="$(sudo firewall-cmd --permanent --get-zone-of-interface="$requested" 2>/dev/null || true)"
  if [[ -n "$zone" && "$zone" != "no zone" ]]; then
    printf '%s' "$zone"
    return 0
  fi
  die "Unknown firewalld zone or unassigned interface: $requested. Available zones: $(sudo firewall-cmd --permanent --get-zones)"
}

valid_port_number() {
  local port="$1"
  [[ "$port" =~ ^[0-9]+(-[0-9]+)?$ ]] || die "Invalid port or port range: $port"
  if [[ "$port" == *-* ]]; then
    local first="${port%-*}" last="${port#*-}"
    (( first >= 1 && first <= 65535 && last >= first && last <= 65535 )) || die "Port range must be between 1 and 65535 and in ascending order."
  else
    (( port >= 1 && port <= 65535 )) || die "Port must be between 1 and 65535."
  fi
}

parse_port_args() {
  # Results are returned through PORT_SPECS and PORT_TARGET.
  local action="$1"; shift
  local port="$1" protocol="" target
  if [[ "$port" == */* ]]; then
    protocol="${port##*/}"
    port="${port%/*}"
    [[ "$protocol" == tcp || "$protocol" == udp ]] || die "Protocol must be tcp or udp."
    [[ $# -eq 2 ]] || die "Usage: lydsetup firewall port $action <port>[/tcp|/udp] <zone|interface>"
    target="$2"
  elif [[ $# -eq 3 ]]; then
    protocol="$2"
    [[ "$protocol" == tcp || "$protocol" == udp ]] || die "Protocol must be tcp or udp."
    target="$3"
  elif [[ $# -eq 2 ]]; then
    target="$2"
  else
    die "Usage: lydsetup firewall port $action <port> [tcp|udp] <zone|interface>"
  fi
  valid_port_number "$port"
  PORT_TARGET="$(valid_zone "$target")"
  if [[ -n "$protocol" ]]; then
    PORT_SPECS=("$port/$protocol")
  else
    PORT_SPECS=("$port/tcp" "$port/udp")
  fi
}

firewall_port_add() {
  need_user; need_sudo; need_firewalld
  local spec
  parse_port_args add "$@"
  for spec in "${PORT_SPECS[@]}"; do
    sudo firewall-cmd --permanent --zone="$PORT_TARGET" --add-port="$spec"
  done
  sudo firewall-cmd --reload
  printf 'Allowed %s in firewalld zone %s.\n' "${PORT_SPECS[*]}" "$PORT_TARGET"
}

firewall_port_remove() {
  need_user; need_sudo; need_firewalld
  local spec
  parse_port_args remove "$@"
  for spec in "${PORT_SPECS[@]}"; do
    sudo firewall-cmd --permanent --zone="$PORT_TARGET" --remove-port="$spec"
  done
  sudo firewall-cmd --reload
  printf 'Removed %s from firewalld zone %s.\n' "${PORT_SPECS[*]}" "$PORT_TARGET"
}

firewall_port_list() {
  need_user; need_sudo; need_firewalld
  local zone ports port label line config_zone comment
  local -A port_labels=()
  if [[ -r "$FIREWALL_CONFIG" ]]; then
    config_zone=""
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line#"${line%%[![:space:]]*}"}"
      if [[ "$line" =~ ^\[([a-zA-Z0-9_-]+)\]$ ]]; then
        config_zone="${BASH_REMATCH[1]}"
      elif [[ -n "$config_zone" && "$line" =~ ^port[[:space:]]*=[[:space:]]*([^[:space:]#]+)[[:space:]]*(#(.*))?$ ]]; then
        port="${BASH_REMATCH[1]}"
        comment="${BASH_REMATCH[3]:-}"
        comment="${comment#"${comment%%[![:space:]]*}"}"
        [[ -n "$comment" ]] && port_labels["$config_zone|$port"]="$comment"
      fi
    done < "$FIREWALL_CONFIG"
  fi
  printf '%-16s %-18s %s\n' "ZONE" "PORT" "PURPOSE"
  for zone in $(sudo firewall-cmd --get-zones); do
    ports="$(sudo firewall-cmd --permanent --zone="$zone" --list-ports)"
    for port in $ports; do
      label="${port_labels["$zone|$port"]:-}"
      [[ -n "$label" ]] || label="-"
      printf '%-16s %-18s %s\n' "$zone" "$port" "$label"
    done
  done
}


FIREWALL_CONFIG="/var/lydsrv/System/Config/firewalld.conf"

firewall_config_save() {
  need_user; need_sudo; need_firewalld
  sudo install -d -o "$(id -u)" -g "$(id -g)" -m 2775 "$(dirname "$FIREWALL_CONFIG")"
  local tmp zone services ports port line config_zone label
  local -A saved_port_labels=()
  # Preserve existing inline descriptions when refreshing the firewall snapshot.
  if [[ -r "$FIREWALL_CONFIG" ]]; then
    config_zone=""
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line#"${line%%[![:space:]]*}"}"
      if [[ "$line" =~ ^\[([a-zA-Z0-9_-]+)\]$ ]]; then
        config_zone="${BASH_REMATCH[1]}"
      elif [[ -n "$config_zone" && "$line" =~ ^port[[:space:]]*=[[:space:]]*([^[:space:]#]+)[[:space:]]*(#(.*))?$ ]]; then
        port="${BASH_REMATCH[1]}"
        label="${BASH_REMATCH[3]:-}"
        label="${label#"${label%%[![:space:]]*}"}"
        [[ -n "$label" ]] && saved_port_labels["$config_zone|$port"]="$label"
      fi
    done < "$FIREWALL_CONFIG"
  fi
  tmp="$(mktemp)"
  {
    printf '# Lyd Atomic firewalld configuration\n'
    printf '# Edit services and ports, then run: lydsetup firewalld load\n'
    printf '# Each section is a firewalld zone. Services are space-separated.\n'
    printf '# Add one port per line: port=PORT/tcp # What this port is for\n'
    printf '# Mixed protocols and both TCP/UDP are supported.\n'
    printf '# Example: port=8123/tcp # Home Assistant web interface\n'
    while IFS= read -r zone; do
      services="$(sudo firewall-cmd --permanent --zone="$zone" --list-services)"
      ports="$(sudo firewall-cmd --permanent --zone="$zone" --list-ports)"
      printf '\n[%s]\nservices=%s\n' "$zone" "$services"
      for port in $ports; do
        label="${saved_port_labels["$zone|$port"]:-}"
        if [[ -n "$label" ]]; then printf 'port=%s # %s\n' "$port" "$label"
        else printf 'port=%s\n' "$port"; fi
      done
    done < <(sudo firewall-cmd --permanent --get-zones | tr ' ' '\n' | sed '/^$/d')
  } > "$tmp"
  sudo install -o "$(id -u)" -g "$(id -g)" -m 0664 "$tmp" "$FIREWALL_CONFIG"
  rm -f "$tmp"
  printf 'Saved permanent firewalld services and ports to %s\n' "$FIREWALL_CONFIG"
}

firewall_config_load() {
  need_user; need_sudo; need_firewalld
  [[ -f "$FIREWALL_CONFIG" ]] || die "Configuration not found: $FIREWALL_CONFIG. Run 'lydsetup firewalld save' first."
  local zone="" line key value token available_zones available_services backup
  local -A cfg_services=() cfg_ports=() seen_zones=()
  # Parse a deliberately simple INI format. Never source or eval this file.
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    if [[ "$line" =~ ^\[([a-zA-Z0-9_-]+)\]$ ]]; then
      zone="${BASH_REMATCH[1]}"
      [[ -z "${seen_zones[$zone]+x}" ]] || die "Duplicate zone section [$zone] in $FIREWALL_CONFIG."
      seen_zones["$zone"]=1
      cfg_services["$zone"]=""
      cfg_ports["$zone"]=""
    elif [[ "$line" =~ ^services[[:space:]]*=[[:space:]]*(.*)$ ]]; then
      [[ -n "$zone" ]] || die "Found a setting before the first [zone] section."
      cfg_services["$zone"]="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ ^ports[[:space:]]*=[[:space:]]*(.*)$ ]]; then
      [[ -n "$zone" ]] || die "Found a setting before the first [zone] section."
      cfg_ports["$zone"]+=" ${BASH_REMATCH[1]}"
    elif [[ "$line" =~ ^port[[:space:]]*=[[:space:]]*([^[:space:]]+)$ ]]; then
      [[ -n "$zone" ]] || die "Found a setting before the first [zone] section."
      cfg_ports["$zone"]+=" ${BASH_REMATCH[1]}"
    else
      die "Invalid line in $FIREWALL_CONFIG: $line"
    fi
  done < "$FIREWALL_CONFIG"

  ((${#seen_zones[@]} > 0)) || die "No zone sections found in $FIREWALL_CONFIG."
  available_zones=" $(sudo firewall-cmd --permanent --get-zones) "
  available_services=" $(sudo firewall-cmd --permanent --get-services) "
  for zone in "${!seen_zones[@]}"; do
    [[ "$available_zones" == *" $zone "* ]] || die "Unknown firewalld zone in config: $zone"
    for token in ${cfg_services[$zone]}; do
      [[ "$token" =~ ^[a-zA-Z0-9_.+-]+$ ]] || die "Invalid service name: $token"
      [[ "$available_services" == *" $token "* ]] || die "Unknown firewalld service '$token' in zone [$zone]."
    done
    for token in ${cfg_ports[$zone]}; do
      [[ "$token" =~ ^([0-9]+(-[0-9]+)?)/(tcp|udp)$ ]] || die "Invalid port entry '$token' in zone [$zone]. Use PORT/tcp or PORT/udp."
      valid_port_number "${token%/*}"
    done
  done

  backup="/var/lydsrv/System/Config/firewalld-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
  sudo install -d -m 0755 "$(dirname "$backup")"
  sudo tar -czf "$backup" -C / etc/firewalld
  printf 'Backed up current firewalld configuration to %s\n' "$backup"
  echo "Applying services and ports for zones listed in $FIREWALL_CONFIG..."
  for zone in "${!seen_zones[@]}"; do
    # Synchronize only services and ports. Interfaces, sources, rich rules,
    # policies, masquerading and all other settings are left untouched.
    for token in $(sudo firewall-cmd --permanent --zone="$zone" --list-services); do
      sudo firewall-cmd --permanent --zone="$zone" --remove-service="$token" >/dev/null
    done
    for token in $(sudo firewall-cmd --permanent --zone="$zone" --list-ports); do
      sudo firewall-cmd --permanent --zone="$zone" --remove-port="$token" >/dev/null
    done
    for token in ${cfg_services[$zone]}; do
      sudo firewall-cmd --permanent --zone="$zone" --add-service="$token" >/dev/null
    done
    for token in ${cfg_ports[$zone]}; do
      sudo firewall-cmd --permanent --zone="$zone" --add-port="$token" >/dev/null
    done
  done
  sudo firewall-cmd --reload
  echo "Firewalld configuration loaded and reloaded successfully."
}

tailscale_enable() {
  need_user; need_sudo
  command -v tailscale >/dev/null 2>&1 || die "Tailscale is not installed."
  systemctl cat tailscaled.service >/dev/null 2>&1 || die "tailscaled.service is not installed."

  echo "Enabling and starting tailscaled.service..."
  sudo systemctl enable --now tailscaled.service

  if command -v firewall-cmd >/dev/null 2>&1 && sudo firewall-cmd --state >/dev/null 2>&1; then
    echo "Configuring firewalld for Tailscale..."
    if ! sudo firewall-cmd --permanent --get-zones | tr ' ' '\n' | grep -Fxq tailscale; then
      sudo firewall-cmd --permanent --new-zone=tailscale
    fi

    # Tailscale creates tailscale0 when the daemon starts. Bind it to a
    # dedicated zone so Serve traffic is handled separately from LAN traffic.
    # Firewalld can persist an interface binding before the interface exists.
    sudo firewall-cmd --permanent --zone=tailscale --add-interface=tailscale0

    # Tailscale Serve and Tailscale Services use HTTPS on the tailnet.
    sudo firewall-cmd --permanent --zone=tailscale --add-port=443/tcp
    sudo firewall-cmd --reload
    echo "Firewalld reloaded. Tailscale zone is configured."
  else
    echo "Firewalld is not running; skipping firewall configuration."
  fi

  echo "Tailscale daemon is enabled and running."
  echo "Authenticate this machine if it has not been connected yet: sudo tailscale up"
}


tailscale_serve_name() {
  local name="$1"
  name="${name#svc:}"
  [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]] || die "Invalid Tailscale Service name: $1"
  printf 'svc:%s' "$name"
}

tailscale_serve_add() {
  need_user
  command -v tailscale >/dev/null 2>&1 || die "Tailscale is not installed."
  [[ $# -ge 2 && $# -le 3 ]] || die "Usage: lydsetup tailscale serve add <service-name> <local-port> [--tcp]"
  local service local_port mode="https"
  service="$(tailscale_serve_name "$1")"
  local_port="$2"
  valid_port_number "$local_port"
  [[ "$local_port" != *-* ]] || die "A single local port is required."
  if [[ $# -eq 3 ]]; then
    [[ "$3" == "--tcp" ]] || die "The only supported optional flag is --tcp."
    mode="tcp"
  fi
  if [[ "$mode" == "tcp" ]]; then
    echo "Configuring raw TCP forwarding for $service: $local_port -> 127.0.0.1:$local_port"
    tailscale serve --service="$service" --tcp="$local_port" "tcp://127.0.0.1:$local_port"
  else
    echo "Configuring HTTPS for $service:443 -> 127.0.0.1:$local_port"
    tailscale serve --service="$service" --https=443 "127.0.0.1:$local_port"
  fi
  echo "Tailscale Serve configuration submitted for $service."
  echo "Check service approval and endpoint status with: lydsetup tailscale serve list"
}

tailscale_serve_remove() {
  need_user
  command -v tailscale >/dev/null 2>&1 || die "Tailscale is not installed."
  [[ $# -eq 1 ]] || die "Usage: lydsetup tailscale serve remove <service-name>"
  local service
  service="$(tailscale_serve_name "$1")"
  echo "Removing all Serve endpoint mappings for $service..."
  tailscale serve clear "$service"
}

tailscale_serve_list() {
  need_user
  command -v tailscale >/dev/null 2>&1 || die "Tailscale is not installed."
  tailscale serve status
}


tailscale_cockpit_hostname() {
  command -v python3 >/dev/null 2>&1 || die "python3 is required to read the Tailscale device name."
  local hostname
  hostname="$(tailscale status --json | python3 -c 'import json,sys; print(json.load(sys.stdin).get("Self", {}).get("DNSName", "").rstrip("."))')" \
    || die "Could not read this device's Tailscale DNS name."
  [[ -n "$hostname" ]] || die "This device is not connected to Tailscale. Run 'sudo tailscale up' first."
  printf '%s' "$hostname"
}

tailscale_cockpit_enable() {
  need_user
  command -v tailscale >/dev/null 2>&1 || die "Tailscale is not installed."
  command -v python3 >/dev/null 2>&1 || die "python3 is required to safely update Cockpit's INI configuration."
  systemctl cat cockpit.socket >/dev/null 2>&1 || die "Cockpit is not installed (cockpit.socket is missing)."
  local hostname url serve_status config="/etc/cockpit/cockpit.conf" backup=""
  hostname="$(tailscale_cockpit_hostname)"
  url="https://${hostname}"

  serve_status="$(tailscale serve status 2>&1 || true)"
  if grep -Fq '|-- / proxy ' <<< "$serve_status" &&
     ! grep -Fq '|-- / proxy http://127.0.0.1:9090' <<< "$serve_status"; then
    die "Tailscale Serve already has a different root handler. It was left unchanged; move that handler or configure Cockpit on a separate hostname/service first."
  fi

  if [[ -f "$config" ]]; then
    backup="${config}.lyd-backup-$(date +%Y%m%d-%H%M%S)"
    sudo cp -a "$config" "$backup"
    echo "Backed up Cockpit configuration to $backup"
  fi

  sudo install -d -m 0755 /etc/cockpit
  sudo python3 - "$config" "$url" <<'PYCOCKPIT'
import os, sys, tempfile
path, https_origin = sys.argv[1:3]
wss_origin = "wss://" + https_origin.removeprefix("https://")
try:
    with open(path, encoding="utf-8") as f:
        lines = f.readlines()
except FileNotFoundError:
    lines = []

out = []
section = None
webservice_seen = False
origins_seen = False
protocol_seen = False
origins = []
for line in lines:
    stripped = line.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        if section == "WebService" and not origins_seen:
            out.append("Origins = " + " ".join(dict.fromkeys(origins + [https_origin, wss_origin])) + "\n")
            origins_seen = True
        if section == "WebService" and not protocol_seen:
            out.append("ProtocolHeader = X-Forwarded-Proto\n")
            protocol_seen = True
        section = stripped[1:-1]
        if section == "WebService":
            webservice_seen = True
        out.append(line)
        continue
    if section == "WebService" and stripped and not stripped.startswith(("#", ";")):
        key, sep, value = line.partition("=")
        if sep and key.strip().lower() == "origins":
            origins.extend(value.split())
            if not origins_seen:
                out.append("__LYD_ORIGINS_PLACEHOLDER__\n")
                origins_seen = True
            continue
        if sep and key.strip().lower() == "protocolheader":
            if not protocol_seen:
                out.append("ProtocolHeader = X-Forwarded-Proto\n")
                protocol_seen = True
            continue
    out.append(line)

if section == "WebService":
    if not origins_seen:
        out.append("Origins = " + " ".join(dict.fromkeys(origins + [https_origin, wss_origin])) + "\n")
    if not protocol_seen:
        out.append("ProtocolHeader = X-Forwarded-Proto\n")
if not webservice_seen:
    if out and not out[-1].endswith("\n"):
        out[-1] += "\n"
    out.extend(["\n[WebService]\n",
                "Origins = " + https_origin + " " + wss_origin + "\n",
                "ProtocolHeader = X-Forwarded-Proto\n"])

for i, line in enumerate(out):
    if line == "__LYD_ORIGINS_PLACEHOLDER__\n":
        out[i] = "Origins = " + " ".join(dict.fromkeys(origins + [https_origin, wss_origin])) + "\n"

fd, tmp = tempfile.mkstemp(prefix=".cockpit.conf.", dir=os.path.dirname(path), text=True)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.writelines(out)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
finally:
    if os.path.exists(tmp):
        os.unlink(tmp)
PYCOCKPIT

  echo "Restarting Cockpit socket..."
  sudo systemctl restart cockpit.socket
  sudo systemctl try-restart cockpit.service >/dev/null 2>&1 || true

  echo "Configuring Tailscale Serve at $url..."
  if ! grep -Fq '|-- / proxy http://127.0.0.1:9090' <<< "$serve_status"; then
    tailscale serve --bg --https=443 http://127.0.0.1:9090
  else
    echo "Cockpit is already configured as the Tailscale Serve root handler."
  fi
  echo
  echo "Cockpit Tailscale access is configured:"
  echo "  $url"
  echo "Cockpit backend: http://127.0.0.1:9090 (local only)"
  echo "Tailnet ACLs still control which devices and users can connect."
}

tailscale_cockpit_status() {
  need_user; need_sudo
  command -v tailscale >/dev/null 2>&1 || die "Tailscale is not installed."
  local hostname
  hostname="$(tailscale_cockpit_hostname)"
  echo "Cockpit Tailscale URL: https://${hostname}"
  echo
  tailscale serve status
  echo
  if sudo test -r /etc/cockpit/cockpit.conf; then
    echo "Cockpit WebService configuration:"
    sudo awk '/^\[WebService\]$/ { in_section=1; print; next } /^\[/ && in_section { exit } in_section { print }' /etc/cockpit/cockpit.conf
  else
    echo "No /etc/cockpit/cockpit.conf file exists."
  fi
}

tailscale_cockpit_disable() {
  need_user
  command -v tailscale >/dev/null 2>&1 || die "Tailscale is not installed."
  local status
  status="$(tailscale serve status 2>&1 || true)"
  grep -Fq '|-- / proxy http://127.0.0.1:9090' <<< "$status" ||
    die "The Tailscale Serve root handler is not configured for Cockpit; leaving Serve unchanged."
  echo "Disabling the Cockpit root handler in Tailscale Serve..."
  tailscale serve --https=443 off
  echo "Cockpit is no longer published through Tailscale Serve."
  echo "Cockpit's allowed-origin and proxy-header settings were retained in /etc/cockpit/cockpit.conf."
}

tailscale_forward_add() {
  need_user
  [[ $# -ge 1 && $# -le 2 ]] || die "Usage: lydsetup tailscale forward add <port> [tcp|udp]"
  if [[ $# -eq 1 ]]; then
    firewall_port_add "$1" tailscale0
  else
    firewall_port_add "$1" "$2" tailscale0
  fi
  echo "Direct tailnet access is now allowed on the node's Tailscale interface."
  echo "Connect to this node's Tailscale IP and port; no HTTPS or Serve URL is involved."
}

tailscale_forward_remove() {
  need_user
  [[ $# -ge 1 && $# -le 2 ]] || die "Usage: lydsetup tailscale forward remove <port> [tcp|udp]"
  if [[ $# -eq 1 ]]; then
    firewall_port_remove "$1" tailscale0
  else
    firewall_port_remove "$1" "$2" tailscale0
  fi
}

tailscale_forward_list() {
  need_user; need_sudo; need_firewalld
  local zone
  zone="$(valid_zone tailscale0)"
  printf 'Direct tailnet ports in firewalld zone %s:\n' "$zone"
  sudo firewall-cmd --permanent --zone="$zone" --list-ports
}
networkshare_state_write() {
  local protocol="$1" zone="$2" firewall_service="$3" firewall_added="$4" tmp
  tmp="$(mktemp)"
  printf 'protocol=%s\nzone=%s\nfirewall_service=%s\nfirewall_added=%s\n' "$protocol" "$zone" "$firewall_service" "$firewall_added" > "$tmp"
  sudo install -D -m 0644 "$tmp" /etc/lyd/networkshare.conf
  rm -f "$tmp"
}

networkshare_prepare_path() {
  local share_path="$1"
  if [[ -e "$share_path" ]]; then
    [[ -d "$share_path" ]] || die "Share path exists and is not a directory: $share_path"
  else
    sudo install -d -m 2770 -o "$(id -u)" -g "$(id -g)" "$share_path"
  fi
}

networkshare_firewall_add() {
  local zone="$1" service="$2"
  if sudo firewall-cmd --permanent --zone="$zone" --query-service="$service" >/dev/null 2>&1; then
    NETWORKSHARE_FIREWALL_ADDED=no
  else
    sudo firewall-cmd --permanent --zone="$zone" --add-service="$service" >/dev/null
    NETWORKSHARE_FIREWALL_ADDED=yes
  fi
  sudo firewall-cmd --reload
}

networkshare_samba_config() {
  local share_name="$1" share_path="$2" username="$3"
  local config=/etc/samba/smb.conf tmp backup had_config=0
  tmp="$(mktemp)"
  backup="$(mktemp)"
  if sudo test -f "$config"; then
    had_config=1
    sudo cp -a "$config" "$backup"
    sudo cat "$config" | awk '
      /^# BEGIN LYD ATOMIC NETWORK SHARE$/ { skip=1; next }
      /^# END LYD ATOMIC NETWORK SHARE$/ { skip=0; next }
      !skip { print }
    ' > "$tmp"
  else
    printf '[global]\n   workgroup = WORKGROUP\n   security = user\n   server role = standalone server\n\n' > "$tmp"
  fi

  if grep -Fxiq -- "[$share_name]" "$tmp"; then
    rm -f "$tmp" "$backup"
    die "A Samba share named '$share_name' already exists in $config. Choose another name."
  fi

  cat >> "$tmp" <<SMB
# BEGIN LYD ATOMIC NETWORK SHARE
[$share_name]
   path = $share_path
   browseable = yes
   read only = no
   guest ok = no
   valid users = $username
   create mask = 0660
   directory mask = 2770
# END LYD ATOMIC NETWORK SHARE
SMB
  sudo install -D -m 0644 "$tmp" "$config"
  if ! sudo testparm -s "$config" >/dev/null 2>&1; then
    if (( had_config )); then sudo cp -a "$backup" "$config"; else sudo rm -f "$config"; fi
    rm -f "$tmp" "$backup"
    die "Samba rejected the share configuration; the previous configuration was restored."
  fi
  rm -f "$tmp" "$backup"
}

networkshare_disable() {
  need_user; need_sudo
  local state=/etc/lyd/networkshare.conf protocol zone fw_service fw_added tmp
  sudo test -r "$state" || die "No Lyd-managed network share is configured."
  protocol="$(sudo awk -F= '$1=="protocol" { print $2; exit }' "$state")"
  zone="$(sudo awk -F= '$1=="zone" { print $2; exit }' "$state")"
  fw_service="$(sudo awk -F= '$1=="firewall_service" { print $2; exit }' "$state")"
  fw_added="$(sudo awk -F= '$1=="firewall_added" { print $2; exit }' "$state")"
  case "$protocol" in
    samba)
      sudo systemctl disable --now smb.service
      if sudo test -f /etc/samba/smb.conf; then
        tmp="$(mktemp)"
        sudo cat /etc/samba/smb.conf | awk '
          /^# BEGIN LYD ATOMIC NETWORK SHARE$/ { skip=1; next }
          /^# END LYD ATOMIC NETWORK SHARE$/ { skip=0; next }
          !skip { print }
        ' > "$tmp"
        sudo install -m 0644 "$tmp" /etc/samba/smb.conf
        rm -f "$tmp"
      fi
      ;;
    nfs)
      sudo systemctl disable --now nfs-server.service
      sudo rm -f /etc/exports.d/lyd-networkshare.exports
      sudo exportfs -ra || true
      ;;
    *) die "Unknown protocol in $state. Refusing to change services or firewall rules." ;;
  esac

  if [[ "$fw_added" == yes ]] && command -v firewall-cmd >/dev/null 2>&1 &&
     sudo firewall-cmd --state >/dev/null 2>&1; then
    sudo firewall-cmd --permanent --zone="$zone" --remove-service="$fw_service" >/dev/null 2>&1 || true
    sudo firewall-cmd --reload
  fi
  sudo rm -f "$state"
  echo "Lyd-managed $protocol network sharing is disabled."
  echo "The shared directory and Samba password were left unchanged."
}

networkshare_enable() {
  need_user; need_sudo
  local state=/etc/lyd/networkshare.conf protocol choice share_path share_name zone fw_service service client_range
  if sudo test -r "$state"; then
    local old_protocol
    old_protocol="$(sudo awk -F= '$1=="protocol" { print $2; exit }' "$state")"
    read -r -p "A Lyd-managed $old_protocol share exists. Replace it? [y/N] " choice
    [[ "$choice" =~ ^[Yy]$ ]] || { echo "Cancelled."; return 0; }
    networkshare_disable
  fi

  command -v firewall-cmd >/dev/null 2>&1 || die "firewalld is not installed in this image."
  echo "Starting firewalld so the selected share can be opened in one firewall zone..."
  sudo systemctl enable --now firewalld.service
  need_firewalld

  echo "Choose the network share type:"
  echo "  1) Samba (SMB, for Windows and most desktop clients)"
  echo "  2) NFS (for Linux and Unix clients)"
  read -r -p "Share type [1/2]: " choice
  case "${choice,,}" in
    1|s|samba|smb) protocol=samba ;;
    2|n|nfs) protocol=nfs ;;
    *) die "Choose 1 for Samba or 2 for NFS." ;;
  esac

  read -r -p "Directory to share [/srv/lyd-networkshare]: " share_path
  share_path="${share_path:-/srv/lyd-networkshare}"
  [[ "$share_path" =~ ^/[A-Za-z0-9._/-]+$ ]] ||
    die "Use an absolute path containing only letters, numbers, dots, underscores, slashes and hyphens."
  [[ "$share_path" != "/" && "$share_path" != *"//"* && "$share_path" != *"/../"* && "$share_path" != */.. && "$share_path" != *"/./"* ]] ||
    die "The share path cannot be / or contain empty, . or .. path components."
  networkshare_prepare_path "$share_path"

  read -r -p "Firewalld zone for client access [public]: " zone
  zone="${zone:-public}"
  zone="$(valid_zone "$zone")"

  case "$protocol" in
    samba)
      command -v smbpasswd >/dev/null 2>&1 || die "Samba is not installed in this image."
      systemctl cat smb.service >/dev/null 2>&1 || die "smb.service is not installed in this image."
      read -r -p "Samba share name [Shared]: " share_name
      share_name="${share_name:-Shared}"
      [[ "$share_name" =~ ^[A-Za-z0-9_-]+$ ]] || die "Share names may contain only letters, numbers, underscores and hyphens."
      sudo -u "$USER" test -w "$share_path" ||
        die "The current user cannot write to $share_path. Adjust its ownership or permissions before enabling the share."
      if sudo pdbedit -L 2>/dev/null | cut -d: -f1 | grep -Fxq -- "$USER"; then
        echo "A Samba account already exists for $USER; keeping its current Samba password."
        echo "To change it later, run: sudo smbpasswd $USER"
      else
        echo "Set a Samba password for your current account ($USER)."
        sudo smbpasswd -a "$USER"
      fi
      networkshare_samba_config "$share_name" "$share_path" "$USER"
      fw_service=samba
      service=smb.service
      ;;
    nfs)
      systemctl cat nfs-server.service >/dev/null 2>&1 || die "nfs-server.service is not installed in this image."
      command -v python3 >/dev/null 2>&1 || die "python3 is required to validate the NFS client network."
      read -r -p "Client IP address or CIDR allowed to mount this share (required): " client_range
      [[ -n "$client_range" ]] || die "An NFS client address or network is required."
      client_range="$(python3 - "$client_range" <<'PY'
import ipaddress
import sys
try:
    print(ipaddress.ip_network(sys.argv[1], strict=False))
except ValueError as exc:
    print(exc, file=sys.stderr)
    raise SystemExit(1)
PY
      )" || die "Enter a valid NFS client IP address or CIDR, such as 192.168.1.0/24."
      local exports_tmp
      exports_tmp="$(mktemp)"
      printf '%s %s(rw,sync,no_subtree_check,root_squash)\n' "$share_path" "$client_range" > "$exports_tmp"
      sudo install -D -m 0644 "$exports_tmp" /etc/exports.d/lyd-networkshare.exports
      rm -f "$exports_tmp"
      sudo exportfs -ra
      fw_service=nfs
      service=nfs-server.service
      ;;
  esac

  networkshare_firewall_add "$zone" "$fw_service"
  networkshare_state_write "$protocol" "$zone" "$fw_service" "$NETWORKSHARE_FIREWALL_ADDED"
  sudo systemctl enable --now "$service"
  echo "$protocol network share is enabled."
  echo "Shared directory: $share_path"
  echo "Firewall zone: $zone"
  if [[ "$protocol" == nfs ]]; then
    echo "Allowed NFS clients: $client_range"
  else
    echo "Samba user: $USER (connect using this account's Samba password)"
  fi
}

sunshine_enable() {
  need_user
  systemctl --user enable --now app-dev.lizardbyte.app.Sunshine.service
  echo "Sunshine is enabled and running for this user."
  echo "It will start automatically when your user session starts."
}

sunshine_disable() {
  need_user
  systemctl --user disable --now app-dev.lizardbyte.app.Sunshine.service
  echo "Sunshine is stopped and disabled for this user."
}

usage() {
  cat <<HELP
lydsetup $VERSION

Usage:
  lydsetup networkshare enable
      Guided setup for a Samba or NFS share; configures its service and firewall.

  lydsetup networkshare disable
      Disable the Lyd-managed share. Shared files and Samba passwords are kept.

  lydsetup sunshine enable
      Enable and start Sunshine for this user, and start it automatically on login.

  lydsetup sunshine disable
      Stop Sunshine and disable automatic startup for this user.

  lydsetup tailscale enable
      Enable and start tailscaled; configure the tailscale firewalld zone if firewalld is running.

  lydsetup tailscale serve add <service-name> <local-port> [--tcp]
      Serve an existing svc:<service-name> at HTTPS port 443, or use --tcp
      to forward raw TCP on the same port as the local application.

  lydsetup tailscale serve list
      Show current Tailscale Serve and Service endpoint status.

  lydsetup tailscale serve remove <service-name>
      Remove all Serve endpoint mappings for the named Service.

  lydsetup tailscale cockpit enable
      Allow Cockpit through Tailscale Serve using this device's HTTPS DNS name.

  lydsetup tailscale cockpit status
      Show Cockpit's Tailscale Serve endpoint and WebService configuration.

  lydsetup tailscale cockpit disable
      Remove the Cockpit Tailscale Serve root handler; retain Cockpit settings.

  lydsetup tailscale forward add <port> [tcp|udp]
      Allow direct access to this node's Tailscale IP on the given port.
      Omit the protocol to allow both TCP and UDP.

  lydsetup tailscale forward list
      List direct ports allowed through the Tailscale firewalld zone.

  lydsetup tailscale forward remove <port> [tcp|udp]
      Remove direct port access; omit the protocol to remove both.

  lydsetup firewall
      Show all firewall subcommands.

  lydsetup firewalld save
      Export permanent allowed services and ports to /var/lydsrv/System/Config/firewalld.conf.

  lydsetup firewalld load
      Synchronize services and ports for zones in the config file, then reload firewalld.

Port configuration examples (inside a zone section):
  port=8123/tcp # Home Assistant web interface
  port=5353/udp # Local service discovery
      One port per line; text after # labels the port in 'firewall port list'.

  port=25565/tcp # Game server connections
  port=25565/udp # Game server discovery
      Add the same port twice to allow both TCP and UDP.

  port=8000-8010/tcp # Application port range
      Port ranges are supported.

  lydsetup firewall port
      Show port management subcommands.

  lydsetup firewall port add <port> <zone|interface>
      Permanently allow both TCP and UDP for the port (default).

  lydsetup firewall port add <port> tcp|udp <zone|interface>
      Permanently allow only the selected protocol.

  lydsetup firewall port add <port/tcp|port/udp> <zone|interface>
      Alternative explicit-protocol syntax.

  lydsetup firewall port remove <port> [tcp|udp] <zone|interface>
      Remove both protocols by default, or only the selected protocol.

  lydsetup firewall port list
      List permanently configured ports in all firewalld zones.

Targets can be firewalld zone names (such as public) or interfaces already
assigned to a zone (such as tailscale0).

Examples:
  lydsetup tailscale enable
  lydsetup tailscale serve add immich 2283
  lydsetup tailscale serve add minecraft 25565 --tcp
  lydsetup tailscale serve list
  lydsetup tailscale serve remove immich
  lydsetup tailscale cockpit enable
  lydsetup tailscale cockpit status
  lydsetup tailscale cockpit disable
  lydsetup tailscale forward add 25566 tcp
  lydsetup tailscale forward list
  lydsetup tailscale forward remove 25566 tcp
  lydsetup firewall
  lydsetup firewall port
  lydsetup firewall port add 8123 public
  lydsetup firewall port add 8123 tailscale0
  lydsetup firewall port add 8123 tcp public
  lydsetup firewall port add 8123/udp public
  lydsetup firewall port remove 8123 public
  lydsetup firewall port remove 8123 udp tailscale0
  lydsetup firewall port list
  lydsetup firewalld save
  lydsetup firewalld load
HELP
}
main() {
  case "${1:-}" in
    networkshare)
      if [[ $# -eq 1 || "${2:-}" == --help || "${2:-}" == -h ]]; then
        echo "Network share commands:"
        echo "  lydsetup networkshare enable   Set up a guided Samba or NFS share"
        echo "  lydsetup networkshare disable  Stop and remove the Lyd-managed share"
        exit 0
      fi
      [[ $# -eq 2 ]] || die "Usage: lydsetup networkshare {enable|disable}"
      case "$2" in
        enable) networkshare_enable ;;
        disable) networkshare_disable ;;
        *) die "Usage: lydsetup networkshare {enable|disable}" ;;
      esac
      ;;
    sunshine)
      if [[ $# -eq 1 || "${2:-}" == --help || "${2:-}" == -h ]]; then
        echo "Sunshine commands:"
        echo "  lydsetup sunshine enable   Enable and start Sunshine for this user"
        echo "  lydsetup sunshine disable  Stop Sunshine and disable automatic startup"
        exit 0
      fi
      [[ $# -eq 2 ]] || die "Usage: lydsetup sunshine {enable|disable}"
      case "$2" in
        enable) sunshine_enable ;;
        disable) sunshine_disable ;;
        *) die "Usage: lydsetup sunshine {enable|disable}" ;;
      esac
      ;;
    tailscale)
      if [[ $# -eq 1 || "${2:-}" == --help || "${2:-}" == -h ]]; then
        echo "Tailscale commands:"
        echo "  lydsetup tailscale enable          Enable tailscaled and configure its firewalld zone"
        echo "  lydsetup tailscale serve           Show Service serving subcommands"
        echo "  lydsetup tailscale cockpit        Configure Cockpit over Tailscale Serve"
        echo "  lydsetup tailscale forward         Manage direct Tailscale-IP port access"
        exit 0
      fi
      case "${2:-}" in
        enable)
          [[ $# -eq 2 ]] || die "Usage: lydsetup tailscale enable"
          tailscale_enable
          ;;
        serve)
          if [[ $# -eq 2 || "${3:-}" == --help || "${3:-}" == -h ]]; then
            echo "Tailscale Service serving commands:"
            echo "  lydsetup tailscale serve add <service-name> <local-port> [--tcp]"
            echo "  lydsetup tailscale serve list"
            echo "  lydsetup tailscale serve remove <service-name>"
            echo "Use an existing Tailscale Service; the svc: prefix is optional."
            exit 0
          fi
          case "${3:-}" in
            add) shift 3; tailscale_serve_add "$@" ;;
            list|status) [[ $# -eq 3 ]] || die "Usage: lydsetup tailscale serve list"; tailscale_serve_list ;;
            remove|rm) shift 3; tailscale_serve_remove "$@" ;;
            *) die "Unknown Tailscale Serve command: ${3:-}" ;;
          esac
          ;;
        cockpit)
          if [[ $# -eq 2 || "${3:-}" == --help || "${3:-}" == -h ]]; then
            echo "Cockpit over Tailscale Serve commands:"
            echo "  lydsetup tailscale cockpit enable"
            echo "  lydsetup tailscale cockpit status"
            echo "  lydsetup tailscale cockpit disable"
            exit 0
          fi
          [[ $# -eq 3 ]] || die "Usage: lydsetup tailscale cockpit {enable|status|disable}"
          case "$3" in
            enable|setup) tailscale_cockpit_enable ;;
            status|list) tailscale_cockpit_status ;;
            disable|remove) tailscale_cockpit_disable ;;
            *) die "Unknown Cockpit Tailscale command: $3" ;;
          esac
          ;;
        forward)
          if [[ $# -eq 2 || "${3:-}" == --help || "${3:-}" == -h ]]; then
            echo "Direct Tailscale-IP port forwarding commands:"
            echo "  lydsetup tailscale forward add <port> [tcp|udp]"
            echo "  lydsetup tailscale forward list"
            echo "  lydsetup tailscale forward remove <port> [tcp|udp]"
            echo "Omit the protocol to allow or remove both TCP and UDP."
            exit 0
          fi
          case "${3:-}" in
            add) shift 3; tailscale_forward_add "$@" ;;
            list|status) [[ $# -eq 3 ]] || die "Usage: lydsetup tailscale forward list"; tailscale_forward_list ;;
            remove|rm) shift 3; tailscale_forward_remove "$@" ;;
            *) die "Unknown Tailscale forward command: ${3:-}" ;;
          esac
          ;;
        *) die "Usage: lydsetup tailscale {enable|serve|cockpit|forward}" ;;
      esac
      ;;
    firewalld)
      if [[ $# -eq 1 || "${2:-}" == --help || "${2:-}" == -h ]]; then
        echo "Firewalld configuration commands:"
        echo "  lydsetup firewalld save    Export current permanent services and ports"
        echo "  lydsetup firewalld load    Apply services and ports from $FIREWALL_CONFIG"
        exit 0
      fi
      [[ $# -eq 2 ]] || die "Usage: lydsetup firewalld {save|load}"
      case "$2" in
        save) firewall_config_save ;;
        load) firewall_config_load ;;
        *) die "Unknown firewalld command: $2. Use save or load." ;;
      esac
      ;;
    firewall)
      if [[ $# -eq 1 || "${2:-}" == --help || "${2:-}" == -h ]]; then
        usage
        exit 0
      fi
      [[ "${2:-}" == port ]] || die "Usage: lydsetup firewall {port}"
      if [[ $# -eq 2 || "${3:-}" == --help || "${3:-}" == -h ]]; then
        usage
        exit 0
      fi
      case "${3:-}" in
        add|remove|rm)
          if [[ $# -eq 3 || "${4:-}" == --help || "${4:-}" == -h ]]; then
            echo "Usage:"
            echo "  lydsetup firewall port ${3} <port> [tcp|udp] <zone|interface>"
            echo "  lydsetup firewall port ${3} <port/tcp|port/udp> <zone|interface>"
            echo "Omit the protocol to apply the operation to both TCP and UDP."
            exit 0
          fi
          local local_action="${3}"
          shift 3
          if [[ "$local_action" == add ]]; then firewall_port_add "$@"; else firewall_port_remove "$@"; fi
          ;;
        list) [[ $# -eq 3 ]] || die "Usage: lydsetup firewall port list"; firewall_port_list ;;
        *) usage >&2; die "Unknown firewall port command: ${3:-}" ;;
      esac
      ;;
    --version) echo "$VERSION" ;;
    --help|-h|"") usage ;;
    *) usage >&2; die "Unknown command: $1" ;;
  esac
}
main "$@"
