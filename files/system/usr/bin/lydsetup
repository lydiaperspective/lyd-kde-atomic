#!/usr/bin/env bash
# Lyd Atomic service and firewall setup helper.
set -Eeuo pipefail

VERSION="1.1.0"

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
need_user() { [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."; }
need_sudo() {
  command -v sudo >/dev/null 2>&1 || die "sudo is required."
}
need_firewalld() {
  command -v firewall-cmd >/dev/null 2>&1 || die "firewall-cmd is not installed."
  sudo firewall-cmd --state >/dev/null 2>&1 || die "firewalld is not running."
}
valid_zone() {
  local requested="$1" zone
  for zone in $(sudo firewall-cmd --permanent --get-zones); do
    [[ "$zone" == "$requested" ]] && { printf '%s' "$requested"; return 0; }
  done

  # Accept an interface name (for example tailscale0) and resolve its
  # permanent firewalld zone. An interface must already be assigned to a zone.
  zone="$(sudo firewall-cmd --permanent --get-zone-of-interface="$requested" 2>/dev/null || true)"
  if [[ -n "$zone" && "$zone" != "no zone" ]]; then
    printf '%s' "$zone"
    return 0
  fi
  die "Unknown firewalld zone or unassigned interface: $requested. Available zones: $(sudo firewall-cmd --permanent --get-zones)"
}

valid_port_number() {
  local port="$1"
  [[ "$port" =~ ^[0-9]+(-[0-9]+)?$ ]] || die "Invalid port or port range: $port"
  if [[ "$port" == *-* ]]; then
    local first="${port%-*}" last="${port#*-}"
    (( first >= 1 && first <= 65535 && last >= first && last <= 65535 )) || die "Port range must be between 1 and 65535 and in ascending order."
  else
    (( port >= 1 && port <= 65535 )) || die "Port must be between 1 and 65535."
  fi
}

parse_port_args() {
  # Results are returned through PORT_SPECS and PORT_TARGET.
  local action="$1"; shift
  local port="$1" protocol="" target
  if [[ "$port" == */* ]]; then
    protocol="${port##*/}"
    port="${port%/*}"
    [[ "$protocol" == tcp || "$protocol" == udp ]] || die "Protocol must be tcp or udp."
    [[ $# -eq 2 ]] || die "Usage: lydsetup firewall port $action <port>[/tcp|/udp] <zone|interface>"
    target="$2"
  elif [[ $# -eq 3 ]]; then
    protocol="$2"
    [[ "$protocol" == tcp || "$protocol" == udp ]] || die "Protocol must be tcp or udp."
    target="$3"
  elif [[ $# -eq 2 ]]; then
    target="$2"
  else
    die "Usage: lydsetup firewall port $action <port> [tcp|udp] <zone|interface>"
  fi
  valid_port_number "$port"
  PORT_TARGET="$(valid_zone "$target")"
  if [[ -n "$protocol" ]]; then
    PORT_SPECS=("$port/$protocol")
  else
    PORT_SPECS=("$port/tcp" "$port/udp")
  fi
}

firewall_port_add() {
  need_user; need_sudo; need_firewalld
  local spec
  parse_port_args add "$@"
  for spec in "${PORT_SPECS[@]}"; do
    sudo firewall-cmd --permanent --zone="$PORT_TARGET" --add-port="$spec"
  done
  sudo firewall-cmd --reload
  printf 'Allowed %s in firewalld zone %s.\n' "${PORT_SPECS[*]}" "$PORT_TARGET"
}

firewall_port_remove() {
  need_user; need_sudo; need_firewalld
  local spec
  parse_port_args remove "$@"
  for spec in "${PORT_SPECS[@]}"; do
    sudo firewall-cmd --permanent --zone="$PORT_TARGET" --remove-port="$spec"
  done
  sudo firewall-cmd --reload
  printf 'Removed %s from firewalld zone %s.\n' "${PORT_SPECS[*]}" "$PORT_TARGET"
}

firewall_port_list() {
  need_user; need_sudo; need_firewalld
  local zone ports port label line config_zone comment
  local -A port_labels=()
  if [[ -r "$FIREWALL_CONFIG" ]]; then
    config_zone=""
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line#" ${line%%[![:space:]]*}"}"
      if [[ "$line" =~ ^\[([a-zA-Z0-9_-]+)\]$ ]]; then
        config_zone="${BASH_REMATCH[1]}"
      elif [[ -n "$config_zone" && "$line" =~ ^port[[:space:]]*=[[:space:]]*([^[:space:]#]+)[[:space:]]*(#(.*))?$ ]]; then
        port="${BASH_REMATCH[1]}"
        comment="${BASH_REMATCH[3]:-}"
        comment="${comment#" ${comment%%[![:space:]]*}"}"
        [[ -n "$comment" ]] && port_labels["$config_zone|$port"]="$comment"
      fi
    done < "$FIREWALL_CONFIG"
  fi
  printf '%-16s %-18s %s\n' "ZONE" "PORT" "PURPOSE"
  for zone in $(sudo firewall-cmd --get-zones); do
    ports="$(sudo firewall-cmd --permanent --zone="$zone" --list-ports)"
    for port in $ports; do
      label="${port_labels["$zone|$port"]:-}"
      [[ -n "$label" ]] || label="-"
      printf '%-16s %-18s %s\n' "$zone" "$port" "$label"
    done
  done
}


FIREWALL_CONFIG="/var/lydsrv/System/Config/firewalld.conf"

firewall_config_save() {
  need_user; need_sudo; need_firewalld
  sudo install -d -o "$(id -u)" -g "$(id -g)" -m 2775 "$(dirname "$FIREWALL_CONFIG")"
  local tmp zone services ports
  tmp="$(mktemp)"
  {
    printf '# Lyd Atomic firewalld configuration\n'
    printf '# Edit services and ports, then run: lydsetup firewalld load\n'
    printf '# Each section is a firewalld zone. Services are space-separated.\n'
    printf '# Add one port per line: port=PORT/tcp # What this port is for\n'
    printf '# Mixed protocols and both TCP/UDP are supported.\n'
    printf '# Example: port=8123/tcp # Home Assistant web interface\n'
    while IFS= read -r zone; do
      services="$(sudo firewall-cmd --permanent --zone="$zone" --list-services)"
      ports="$(sudo firewall-cmd --permanent --zone="$zone" --list-ports)"
      printf '\n[%s]\nservices=%s\n' "$zone" "$services"
      for port in $ports; do printf 'port=%s\n' "$port"; done
    done < <(sudo firewall-cmd --permanent --get-zones | tr ' ' '\n' | sed '/^$/d')
  } > "$tmp"
  sudo install -o "$(id -u)" -g "$(id -g)" -m 0664 "$tmp" "$FIREWALL_CONFIG"
  rm -f "$tmp"
  printf 'Saved permanent firewalld services and ports to %s\n' "$FIREWALL_CONFIG"
}

firewall_config_load() {
  need_user; need_sudo; need_firewalld
  [[ -f "$FIREWALL_CONFIG" ]] || die "Configuration not found: $FIREWALL_CONFIG. Run 'lydsetup firewalld save' first."
  local zone="" line key value token available_zones available_services backup
  local -A cfg_services=() cfg_ports=() seen_zones=()
  # Parse a deliberately simple INI format. Never source or eval this file.
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    if [[ "$line" =~ ^\[([a-zA-Z0-9_-]+)\]$ ]]; then
      zone="${BASH_REMATCH[1]}"
      [[ -z "${seen_zones[$zone]+x}" ]] || die "Duplicate zone section [$zone] in $FIREWALL_CONFIG."
      seen_zones["$zone"]=1
      cfg_services["$zone"]=""
      cfg_ports["$zone"]=""
    elif [[ "$line" =~ ^(services|ports)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
      [[ -n "$zone" ]] || die "Found a setting before the first [zone] section."
      key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
      if [[ "$key" == services ]]; then cfg_services["$zone"]="$value"; else cfg_ports["$zone"]="$value"; fi
    else
      die "Invalid line in $FIREWALL_CONFIG: $line"
    fi
  done < "$FIREWALL_CONFIG"

  ((${#seen_zones[@]} > 0)) || die "No zone sections found in $FIREWALL_CONFIG."
  available_zones=" $(sudo firewall-cmd --permanent --get-zones) "
  available_services=" $(sudo firewall-cmd --permanent --get-services) "
  for zone in "${!seen_zones[@]}"; do
    [[ "$available_zones" == *" $zone "* ]] || die "Unknown firewalld zone in config: $zone"
    for token in ${cfg_services[$zone]}; do
      [[ "$token" =~ ^[a-zA-Z0-9_.+-]+$ ]] || die "Invalid service name: $token"
      [[ "$available_services" == *" $token "* ]] || die "Unknown firewalld service '$token' in zone [$zone]."
    done
    for token in ${cfg_ports[$zone]}; do
      [[ "$token" =~ ^([0-9]+(-[0-9]+)?)/(tcp|udp)$ ]] || die "Invalid port entry '$token' in zone [$zone]. Use PORT/tcp or PORT/udp."
      valid_port_number "${token%/*}"
    done
  done

  backup="/var/lydsrv/System/Config/firewalld-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
  sudo install -d -m 0755 "$(dirname "$backup")"
  sudo tar -czf "$backup" -C / etc/firewalld
  printf 'Backed up current firewalld configuration to %s\n' "$backup"
  echo "Applying services and ports for zones listed in $FIREWALL_CONFIG..."
  for zone in "${!seen_zones[@]}"; do
    # Synchronize only services and ports. Interfaces, sources, rich rules,
    # policies, masquerading and all other settings are left untouched.
    for token in $(sudo firewall-cmd --permanent --zone="$zone" --list-services); do
      sudo firewall-cmd --permanent --zone="$zone" --remove-service="$token" >/dev/null
    done
    for token in $(sudo firewall-cmd --permanent --zone="$zone" --list-ports); do
      sudo firewall-cmd --permanent --zone="$zone" --remove-port="$token" >/dev/null
    done
    for token in ${cfg_services[$zone]}; do
      sudo firewall-cmd --permanent --zone="$zone" --add-service="$token" >/dev/null
    done
    for token in ${cfg_ports[$zone]}; do
      sudo firewall-cmd --permanent --zone="$zone" --add-port="$token" >/dev/null
    done
  done
  sudo firewall-cmd --reload
  echo "Firewalld configuration loaded and reloaded successfully."
}

tailscale_enable() {
  need_user; need_sudo
  command -v tailscale >/dev/null 2>&1 || die "Tailscale is not installed."
  systemctl cat tailscaled.service >/dev/null 2>&1 || die "tailscaled.service is not installed."

  echo "Enabling and starting tailscaled.service..."
  sudo systemctl enable --now tailscaled.service

  if command -v firewall-cmd >/dev/null 2>&1 && sudo firewall-cmd --state >/dev/null 2>&1; then
    echo "Configuring firewalld for Tailscale..."
    if ! sudo firewall-cmd --permanent --get-zones | tr ' ' '\n' | grep -Fxq tailscale; then
      sudo firewall-cmd --permanent --new-zone=tailscale
    fi

    # Tailscale creates tailscale0 when the daemon starts. Bind it to a
    # dedicated zone so Serve traffic is handled separately from LAN traffic.
    # Firewalld can persist an interface binding before the interface exists.
    sudo firewall-cmd --permanent --zone=tailscale --add-interface=tailscale0

    # Tailscale Serve and Tailscale Services use HTTPS on the tailnet.
    sudo firewall-cmd --permanent --zone=tailscale --add-port=443/tcp
    sudo firewall-cmd --reload
    echo "Firewalld reloaded. Tailscale zone is configured."
  else
    echo "Firewalld is not running; skipping firewall configuration."
  fi

  echo "Tailscale daemon is enabled and running."
  echo "Authenticate this machine if it has not been connected yet: sudo tailscale up"
}

usage() {
  cat <<HELP
lydsetup $VERSION

Usage:
  lydsetup tailscale enable
      Enable and start tailscaled; configure the tailscale firewalld zone if firewalld is running.

  lydsetup firewall
      Show all firewall subcommands.

  lydsetup firewalld save
      Export permanent allowed services and ports to /var/lydsrv/System/Config/firewalld.conf.

  lydsetup firewalld load
      Synchronize services and ports for zones in the config file, then reload firewalld.

Port configuration examples (inside a zone section):
  ports=8123/tcp 5353/udp
      Allow TCP 8123 and UDP 5353.

  ports=8123/tcp 8123/udp
      Allow port 8123 over both TCP and UDP.

  ports=8000-8010/tcp 9000/udp
      Allow a TCP range and a separate UDP port.

  lydsetup firewall port
      Show port management subcommands.

  lydsetup firewall port add <port> <zone|interface>
      Permanently allow both TCP and UDP for the port (default).

  lydsetup firewall port add <port> tcp|udp <zone|interface>
      Permanently allow only the selected protocol.

  lydsetup firewall port add <port/tcp|port/udp> <zone|interface>
      Alternative explicit-protocol syntax.

  lydsetup firewall port remove <port> [tcp|udp] <zone|interface>
      Remove both protocols by default, or only the selected protocol.

  lydsetup firewall port list
      List permanently configured ports in all firewalld zones.

Targets can be firewalld zone names (such as public) or interfaces already
assigned to a zone (such as tailscale0).

Examples:
  lydsetup tailscale enable
  lydsetup firewall
  lydsetup firewall port
  lydsetup firewall port add 8123 public
  lydsetup firewall port add 8123 tailscale0
  lydsetup firewall port add 8123 tcp public
  lydsetup firewall port add 8123/udp public
  lydsetup firewall port remove 8123 public
  lydsetup firewall port remove 8123 udp tailscale0
  lydsetup firewall port list
  lydsetup firewalld save
  lydsetup firewalld load
HELP
}
main() {
  case "${1:-}" in
    tailscale)
      if [[ $# -eq 1 || "${2:-}" == --help || "${2:-}" == -h ]]; then
        echo "Tailscale commands:"
        echo "  lydsetup tailscale enable    Enable tailscaled and configure its firewalld zone"
        exit 0
      fi
      [[ "${2:-}" == enable && $# -eq 2 ]] || die "Usage: lydsetup tailscale enable"
      tailscale_enable
      ;;
    firewalld)
      if [[ $# -eq 1 || "${2:-}" == --help || "${2:-}" == -h ]]; then
        echo "Firewalld configuration commands:"
        echo "  lydsetup firewalld save    Export current permanent services and ports"
        echo "  lydsetup firewalld load    Apply services and ports from $FIREWALL_CONFIG"
        exit 0
      fi
      [[ $# -eq 2 ]] || die "Usage: lydsetup firewalld {save|load}"
      case "$2" in
        save) firewall_config_save ;;
        load) firewall_config_load ;;
        *) die "Unknown firewalld command: $2. Use save or load." ;;
      esac
      ;;
    firewall)
      if [[ $# -eq 1 || "${2:-}" == --help || "${2:-}" == -h ]]; then
        usage
        exit 0
      fi
      [[ "${2:-}" == port ]] || die "Usage: lydsetup firewall {port}"
      if [[ $# -eq 2 || "${3:-}" == --help || "${3:-}" == -h ]]; then
        usage
        exit 0
      fi
      case "${3:-}" in
        add|remove|rm)
          if [[ $# -eq 3 || "${4:-}" == --help || "${4:-}" == -h ]]; then
            echo "Usage:"
            echo "  lydsetup firewall port ${3} <port> [tcp|udp] <zone|interface>"
            echo "  lydsetup firewall port ${3} <port/tcp|port/udp> <zone|interface>"
            echo "Omit the protocol to apply the operation to both TCP and UDP."
            exit 0
          fi
          local local_action="${3}"
          shift 3
          if [[ "$local_action" == add ]]; then firewall_port_add "$@"; else firewall_port_remove "$@"; fi
          ;;
        list) [[ $# -eq 3 ]] || die "Usage: lydsetup firewall port list"; firewall_port_list ;;
        *) usage >&2; die "Unknown firewall port command: ${3:-}" ;;
      esac
      ;;
    --version) echo "$VERSION" ;;
    --help|-h|"") usage ;;
    *) usage >&2; die "Unknown command: $1" ;;
  esac
}
main "$@"
