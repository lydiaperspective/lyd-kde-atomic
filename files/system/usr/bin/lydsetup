#!/usr/bin/env bash
# Optional feature manager for Lyd Atomic.
set -Eeuo pipefail
VERSION=0.6.9
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/lydsetup/logs"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/lydsetup-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$LOG") 2>&1

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
confirm() {
  local answer
  read -r -p "$1 [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]]
}
require_packages() {
  local -a missing=()
  local pkg
  for pkg in "$@"; do rpm -q "$pkg" >/dev/null 2>&1 || missing+=("$pkg"); done
  if (("${#missing[@]}" != 0)); then
    echo "This feature requires packages that are not present in this image:" >&2
    printf '  - %s\n' "${missing[@]}" >&2
    die "Update to an image build that includes these packages. Lyd Atomic does not layer system RPMs at runtime."
  fi
  echo "All required system packages are already included in this image."
}

# GPGME can pass an empty --display argument to GnuPG when sudo
# strips DISPLAY. Some GPGME versions treat that as a fatal option error,
# which Flatpak reports as a signature-verification failure. Signature
# verification remains enabled; supply a harmless non-empty display value
# only when the caller has no DISPLAY.
flatpak_as_root() {
  local display="${DISPLAY:-:0}"
  sudo env "DISPLAY=$display" flatpak "$@"
}
ensure_flathub_system() {
  command -v flatpak >/dev/null 2>&1 || die "Flatpak is not installed."
  if ! flatpak remotes --system --columns=name | grep -qx flathub; then
    echo "Adding the system-wide Flathub repository."
    flatpak_as_root remote-add --system --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
  fi
  flatpak_as_root remote-modify --system --prio=100 flathub
}
install_flatpaks_system() {
  ensure_flathub_system
  flatpak_as_root install --system --assumeyes --or-update flathub "$@"
}
setup_printscan() {
  echo "This enables CUPS printing, USB/network scanner support and Skanpage."
  echo "All required system packages are already included in the image."
  require_packages cups sane-backends sane-backends-drivers-scanners sane-airscan ipp-usb avahi
  echo "Enabling CUPS printing and Avahi device discovery."
  sudo systemctl enable --now cups.service
  sudo systemctl enable --now avahi-daemon.service
  echo "Installing Skanpage from Flathub."
  install_flatpaks_system org.kde.skanpage
  echo
  echo "Printing and scanning support is enabled."
  echo "Open System Settings > Printers to add a printer."
  echo "Open Skanpage to scan. Device support depends on the printer/scanner's supported protocols."
}
setup_media() {
  echo "Installing media applications from the system Flathub repository."
  install_flatpaks_system \
    com.spotify.Client \
    com.stremio.Stremio \
    org.jellyfin.JellyfinDesktop \
    com.unicornsonlsd.finamp \
    org.fcast.Receiver
  echo
  echo "Media applications are installed."
}

setup_mediaedit() {
  echo "Installing media creation and conversion applications from Flathub."
  install_flatpaks_system \
    org.inkscape.Inkscape \
    org.kde.kdenlive \
    org.kde.krita \
    ca.littlesvr.asunder \
    org.soundconverter.SoundConverter
  echo
  echo "Media editing applications are installed."
}

setup_gaming() {
  if ! rpm -q steam steam-devices gamemode mangohud gamescope >/dev/null 2>&1; then
    die "Gaming packages are not included in this image. Use the NVIDIA Gaming Workstation image; the gaming packages and launcher Flatpaks are preinstalled there."
  fi
  echo "Checking the preinstalled gaming system packages."
  require_packages steam steam-devices gamemode mangohud gamescope
  echo "Preparing Steam Input virtual-controller support."
  sudo modprobe uinput || die "Could not load the uinput kernel module. Check that the running kernel provides CONFIG_INPUT_UINPUT."
  sudo udevadm control --reload-rules
  sudo udevadm trigger --subsystem-match=misc
  echo "Steam is preinstalled as a system RPM. Installing Protontricks and companion game launchers from Flathub."
  install_flatpaks_system \
    com.github.Matoking.protontricks \
    com.vysp3r.ProtonPlus \
    net.lutris.Lutris \
    com.heroicgameslauncher.hgl
  echo
  echo "Gaming setup is complete."
  echo "Steam is installed as a system RPM. Protontricks, ProtonPlus, Lutris and Heroic are installed as system Flatpaks."
  echo "GameMode, MangoHud and Gamescope are included in the image."
  echo "Example Steam launch option for GameMode and MangoHud:"
  echo "  gamemoderun mangohud %command%"
}

setup_gamingui() {
  if ! rpm -q steam steam-devices gamescope >/dev/null 2>&1; then
    die "The Steam and Gamescope packages are not included in this image. Switch to the NVIDIA Gaming Workstation with 'lydsetup nvidia-gaming', then reboot."
  fi
  echo "Checking the preinstalled Steam and Gamescope packages."
  require_packages steam steam-devices gamescope
  local bin_dir="$HOME/.local/bin"
  local app_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  mkdir -p "$bin_dir" "$app_dir"
  cat > "$bin_dir/lyd-gamescope-switch" <<'SWITCH_SCRIPT'
#!/usr/bin/env bash
set -Eeuo pipefail
if [[ "${XDG_SESSION_TYPE:-}" != "wayland" ]]; then
  kdialog --error "The Lyd Gamescope session requires a Wayland desktop. Log into Plasma (Wayland) and try again." 2>/dev/null || true
  exit 1
fi
if ! command -v kdialog >/dev/null 2>&1; then
  echo "KDialog is required to confirm the session switch." >&2
  exit 1
fi
if ! kdialog --warningyesno "You are about to log out of Plasma. At the SDDM login screen, select 'Lyd Gamescope' from the session menu, then sign in to launch Steam in Gamepad UI. To return, log out of Gamescope and select 'Plasma (Wayland)'." --title "Switch to Lyd Gamescope"; then
  exit 0
fi
qdbus_cmd=""
for candidate in qdbus6 qdbus-qt6 qdbus; do
  if command -v "$candidate" >/dev/null 2>&1; then qdbus_cmd="$candidate"; break; fi
done
if [[ -n "$qdbus_cmd" ]]; then
  "$qdbus_cmd" org.kde.Shutdown /Shutdown logout
else
  kdialog --error "Could not find qdbus to safely log out of Plasma. Log out from the application menu, then choose Lyd Gamescope at SDDM." 2>/dev/null || true
  exit 1
fi
SWITCH_SCRIPT
  chmod 0755 "$bin_dir/lyd-gamescope-switch"
  cat > "$app_dir/lyd-gamescope-switch.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Switch to Lyd Gamescope
GenericName=Steam Gaming Session
Comment=Log out and switch to the Steam Gamescope session
Exec=$bin_dir/lyd-gamescope-switch
Icon=steam
Terminal=false
Categories=Game;System;
EOF
  echo
  echo "Steam Gamescope support is configured."
  echo "Use 'Switch to Lyd Gamescope' from the application menu."
  echo "At SDDM, choose 'Lyd Gamescope'. To return, log out and choose 'Plasma (Wayland)'."
}
setup_steamtheme() {
  die "The native Steam RPM is now the supported client. The Lyd Mystical Steam theme installer is not yet implemented in this image."
}

setup_8bitdo() {
  if ! rpm -q steam-devices >/dev/null 2>&1; then
    die "Steam controller device support is not included in this image. Switch with 'lydsetup nvidia-gaming' or 'lydsetup nvidia-gaming', then reboot."
  fi
  echo "Checking the preinstalled Steam controller device support."
  require_packages steam-devices
  local rule_file="/etc/udev/rules.d/71-8bitdo-pro2.rules"
  local temp_file
  temp_file="$(mktemp)"
  cat > "$temp_file" <<'UDEV_RULES'
# 8BitDo USB, wired and 2.4 GHz HID devices
ACTION!="remove", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2dc8", MODE="0660", TAG+="uaccess"

# 8BitDo Bluetooth HID devices
ACTION!="remove", SUBSYSTEM=="hidraw", KERNELS=="*2DC8:*", MODE="0660", TAG+="uaccess"
UDEV_RULES
  sudo install -D -m 0644 "$temp_file" "$rule_file"
  rm -f "$temp_file"
  echo "Reloading udev rules and updating connected HID device permissions."
  sudo udevadm control --reload-rules
  sudo udevadm trigger --subsystem-match=hidraw
  echo
  echo "8BitDo controller support is configured."
  echo "Disconnect and reconnect your Pro 2, then fully restart Steam."
  echo "For the rear paddles, use a controller mode and firmware that exposes them to Steam Input; udev permissions alone cannot create missing controller inputs."
}

setup_virtualization() {
  if rpm -q cockpit-machines >/dev/null 2>&1; then
    echo "The Server edition already includes Cockpit Machines and the KVM/libvirt stack."
  else
    require_packages qemu-kvm libvirt libvirt-daemon-kvm virt-install virt-manager virt-viewer edk2-ovmf swtpm dnsmasq libvirt-daemon-config-network
  fi
  echo "Enabling libvirt and preparing the current account for virtualization."
  sudo systemctl enable --now libvirtd.service
  sudo usermod -aG libvirt,kvm "$USER"
  if command -v virsh >/dev/null 2>&1; then
    sudo virsh net-autostart default || true
    sudo virsh net-start default || true
  fi
  echo "Group membership takes effect after logging out and back in."
}
setup_coolercontrol() {
  require_packages coolercontrol coolercontrold liquidctl
  echo "Enabling the preinstalled CoolerControl daemon."
  sudo systemctl enable --now coolercontrold.service
}
setup_tuned() {
  require_packages tuned tuned-ppd
  echo "TuneD + tuned-ppd will replace power-profiles-daemon."
  confirm "Enable TuneD and tuned-ppd?" || return 0
  sudo systemctl disable --now power-profiles-daemon.service 2>/dev/null || true
  sudo systemctl enable --now tuned.service
  sudo systemctl enable --now tuned-ppd.service
}
setup_tailscale() {
  require_packages tailscale
  sudo systemctl enable --now tailscaled.service
  echo "Tailscale daemon is enabled."
  if command -v kwriteconfig6 >/dev/null 2>&1 || [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
    echo "Installing KTailctl, the KDE desktop interface for Tailscale."
    install_flatpaks_system org.fkoehler.KTailctl
  fi
  if confirm "Run 'tailscale up' now to connect this machine to your tailnet?"; then
    sudo tailscale up
  else
    echo "Connect later with: sudo tailscale up"
  fi
}
setup_solaar() {
  require_packages solaar
  echo "Solaar is included in the image."
  echo "Launch it from the application menu or run: solaar"
}

# Fedora's Distrobox 1.8.2.5 shipped a malformed Podman mount option
# (:ro:rslave). Upstream fixed this in Distrobox PR #2086. Keep a patched
# user-local copy so immutable hosts do not need to modify /usr.
prepare_distrobox_compat() {
  local system_create compat_dir compat_create
  system_create="$(command -v distrobox-create 2>/dev/null || true)"
  [[ -n "$system_create" && -f "$system_create" ]] || die "Could not locate the distrobox-create script."

  # Newer upstream Distrobox already emits the correct :ro,rslave option.
  if grep -Fq 'rorslave=":ro,rslave"' "$system_create" &&
     grep -Fq '${rorslave}' "$system_create"; then
    return 0
  fi

  # Patch only the known affected implementation; fail safely on unknown variants.
  if grep -Fq 'rslave=":rslave"' "$system_create" &&
     grep -Fq ':ro${rslave}' "$system_create"; then
    compat_dir="$HOME/.local/lib/lydsetup/distrobox-compat"
    compat_create="$compat_dir/distrobox-create"
    install -d -m 0755 "$compat_dir"
    install -m 0755 "$system_create" "$compat_create"
    sed -i \
      -e '/rslave=""/a\        rorslave=":ro"' \
      -e '/rslave=":rslave"/a\        rorslave=":ro,rslave"' \
      -e 's/:ro${rslave}/${rorslave}/' \
      "$compat_create"
    if grep -Fq ':ro${rslave}' "$compat_create" ||
       ! grep -Fq 'rorslave=":ro,rslave"' "$compat_create" ||
       ! grep -Fq '${rorslave}' "$compat_create"; then
      rm -f "$compat_create"
      die "Could not safely apply the Distrobox Podman mount compatibility fix."
    fi
    chmod 0755 "$compat_create"
    export PATH="$compat_dir:$PATH"
    echo "Applied the Distrobox 1.8.2.5 read-only mount compatibility fix."
    echo "Using a user-local distrobox-create override; the immutable system image is unchanged."
    return 0
  fi

  echo "Distrobox does not contain the known ro:rslave bug; using the system version."
}

setup_devbox() {
  local config_dir config_file box_name
  box_name="lyd-atomic-dev"
  if ! command -v distrobox >/dev/null 2>&1 || ! command -v podman >/dev/null 2>&1; then
    require_packages distrobox podman
      command -v distrobox >/dev/null 2>&1 || die "Distrobox is still unavailable. Reboot into the new deployment, then run lydsetup again."
    command -v podman >/dev/null 2>&1 || die "Podman is still unavailable. Reboot into the new deployment, then run lydsetup again."
  fi
  prepare_distrobox_compat
  config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/distrobox"
  config_file="$config_dir/lyd-atomic-dev.ini"
  mkdir -p "$config_dir"
  cat > "$config_file" <<'DISTROBOX_CONFIG'
[lyd-atomic-dev]
image=ghcr.io/blue-build/cli:latest-distrobox
exported_bins=/usr/bin/bluebuild
init_hooks=ln -sf /usr/bin/distrobox-host-exec /usr/local/bin/podman
pull=true
start_now=true
DISTROBOX_CONFIG
  echo "Creating or updating the BlueBuild development Distrobox."
  echo "The container uses the host's Podman engine and exports the BlueBuild CLI."
  if ! distrobox assemble create --file "$config_file"; then
    die "Distrobox setup failed. Review the output above and retry with: distrobox assemble create --file '$config_file'"
  fi
  echo
  echo "Development environment is ready."
  echo "Enter it with: distrobox enter $box_name"
  echo "Clone the project with:"
  echo "  mkdir -p ~/Projects && cd ~/Projects"
  echo "  git clone https://github.com/lydiaperspective/lyd-kde-atomic.git"
  echo "  cd lyd-kde-atomic"
  echo "Build an edition with:"
  echo "  bluebuild build recipes/lyd-kde.yml"
  echo "  bluebuild build recipes/lyd-kde-intel.yml"
  echo "  bluebuild build recipes/lyd-server.yml"
  echo "The BlueBuild Distrobox is rootless; use GitHub Actions or an appropriately configured host workflow for publishing images."
}

ensure_distrobox_host() {
  require_packages distrobox podman
  prepare_distrobox_compat
  return 0
}
setup_androiddev() {
  local box_name="lyd-android-dev" repo_dir
  ensure_distrobox_host || return 0
  if ! command -v flatpak >/dev/null 2>&1; then
    echo "Flatpak is required to install Android Studio."
    die "Flatpak is required but is not present in this image."
      command -v flatpak >/dev/null 2>&1 || die "Flatpak is unavailable after deployment. Reboot and retry."
  fi
  echo "This sets up Android Studio on the host and a Fedora development Distrobox."
  echo "The Distrobox includes Git, Java 21, Android platform tools and common build utilities."
  if confirm "Install Android Studio from Flathub and create the Android development environment?"; then
    flatpak install --user --noninteractive flathub com.google.AndroidStudio
  else
    return 0
  fi
  if ! distrobox list --no-color 2>/dev/null | grep -q "$box_name"; then
    distrobox create --name "$box_name" --image registry.fedoraproject.org/fedora:45 --additional-packages "git git-lfs java-21-openjdk-devel android-tools wget curl unzip zip tar findutils which" --yes
  else
    echo "Distrobox $box_name already exists; leaving its contents intact."
  fi
  repo_dir="$HOME/Projects/lyd-kde-atomic"
  mkdir -p "$HOME/Projects"
  if [[ ! -d "$repo_dir/.git" ]]; then
    if [[ -e "$repo_dir" ]]; then
      echo "Skipping clone because $repo_dir already exists and is not a Git repository."
    else
      git clone https://github.com/lydiaperspective/lyd-kde-atomic.git "$repo_dir"
    fi
  else
    echo "Lyd Atomic repository already exists at $repo_dir."
  fi
  echo
  echo "Android development environment is ready."
  echo "Launch Android Studio from the application menu."
  echo "Enter the toolchain container with: distrobox enter $box_name"
  echo "Project checkout: $repo_dir (shared with the container)"
  echo "In Android Studio, set the Android SDK location to a writable host path such as $HOME/Android/Sdk."
  echo "For GitHub access, use the GitHub sign-in flow in Android Studio or configure gh/git credentials separately."
}
setup_containerdev() {
  local box_name="lyd-container-dev"
  ensure_distrobox_host || return 0
  echo "This creates a Fedora container-development environment using the host's rootless Podman engine."
  if ! distrobox list --no-color 2>/dev/null | grep -q "$box_name"; then
    distrobox create --name "$box_name" --image registry.fedoraproject.org/fedora:45 --additional-packages "git git-lfs podman-compose buildah skopeo jq yq curl wget vim-enhanced" --yes
  else
    echo "Distrobox $box_name already exists; leaving its contents intact."
  fi
  distrobox enter "$box_name" -- bash -lc 'mkdir -p "$HOME/.local/bin"; ln -sf /usr/bin/distrobox-host-exec "$HOME/.local/bin/podman"; grep -q "\\.local/bin" "$HOME/.bashrc" 2>/dev/null || echo "export PATH=\\"$HOME/.local/bin:\\$PATH" >> "$HOME/.bashrc"'
  echo
  echo "Container development environment is ready."
  echo "Enter it with: distrobox enter $box_name"
  echo "Podman commands are forwarded to the host's rootless Podman engine."
  echo "Your home directory is shared, so compose projects and source checkouts remain accessible."
}

setup_themedev() {
  local box_name="lyd-theme-dev"
  local repo_dir="$HOME/Development/lyd-kde-themes"
  local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/distrobox"
  local config_file="$config_dir/$box_name.ini"

  ensure_distrobox_host || return 0
  command -v flatpak >/dev/null 2>&1 || die "Flatpak is required for the graphical theme editors. Enable Flatpak/Flathub on this system, then retry."

  echo "This sets up the Mystical KDE theme development environment."
  echo "Graphical editors will be installed as user Flatpaks:"
  echo "  Inkscape (SVG icons, scalable artwork and cursor assets)"
  echo "  Krita (raster artwork, textures and animation frames)"
  echo "  GIMP (raster editing and image cleanup)"
  echo "A Fedora Distrobox will provide Git, Python image/SVG tooling, image optimizers,"
  echo "cursor utilities and Plymouth tools without layering them into the host OS."
  echo "The theme repository will be checked out at: $repo_dir"
  confirm "Install the tools and prepare the theme repository?" || return 0

  if ! flatpak remotes --user --columns=name | grep -qx flathub; then
    flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
  fi
  flatpak install --user --assumeyes flathub org.inkscape.Inkscape org.kde.krita org.gimp.GIMP

  mkdir -p "$config_dir"
  cat > "$config_file" <<'THEME_DISTROBOX_CONFIG'
[lyd-theme-dev]
image=registry.fedoraproject.org/fedora:45
additional_packages="git git-lfs python3 python3-pip python3-pillow python3-cairosvg python3-lxml python3-numpy ImageMagick optipng pngquant xcursorgen plymouth"
pull=true
start_now=true
THEME_DISTROBOX_CONFIG

  echo "Creating or updating the theme toolchain container."
  if ! distrobox assemble create --file "$config_file"; then
    die "Theme toolchain creation failed. Retry with: distrobox assemble create --file '$config_file'"
  fi

  mkdir -p "$HOME/Development"
  if [[ -d "$repo_dir/.git" ]]; then
    local origin
    origin="$(git -C "$repo_dir" remote get-url origin 2>/dev/null || true)"
    [[ "$origin" == "https://github.com/lydiaperspective/lyd-kde-themes.git" || "$origin" == "git@github.com:lydiaperspective/lyd-kde-themes.git" ]] || die "$repo_dir is a Git repository, but its origin is not lyd-kde-themes. Refusing to change it."
    if [[ -n "$(git -C "$repo_dir" status --porcelain)" ]]; then
      die "The existing theme checkout has local changes. Commit or stash them before updating, then rerun: lydsetup dev theme enable"
    fi
    git -C "$repo_dir" pull --ff-only origin main
  elif [[ -e "$repo_dir" ]]; then
    die "$repo_dir already exists but is not a Git repository. Move it aside and retry."
  else
    git clone https://github.com/lydiaperspective/lyd-kde-themes.git "$repo_dir"
  fi

  echo
  echo "Theme development environment is ready."
  echo "Repository: $repo_dir"
  echo "Launch Inkscape, Krita or GIMP from the application menu."
  echo "Enter the toolchain with: distrobox enter $box_name"
  echo "The container and host share your home directory, including the theme checkout."
  echo "Useful tools in the container: git, git-lfs, Python/Pillow, CairoSVG, ImageMagick,"
  echo "optipng, pngquant, xcursorgen and Plymouth."
}

setup_theme_reapply() {
  local installer="/usr/libexec/lyd/lyd-mystical-theme-reapply"
  echo "This reapplies the complete Lyd Mystical theme, including:"
  echo "  Plasma look-and-feel, colors, Breeze icons, cursor and wallpaper"
  echo "  SDDM login screen and background"
  echo "  GRUB boot menu and Plymouth startup theme (initramfs rebuild)"
  echo
  confirm "Reapply the Mystical theme now? This will replace the current desktop theme and wallpaper." || return 0

  [[ -x "$installer" ]] || die "The Mystical theme reapply tool is missing. Update to the latest Lyd Atomic image first."
  sudo "$installer" --reapply

  if command -v plasma-apply-lookandfeel >/dev/null 2>&1; then
    plasma-apply-lookandfeel --apply org.lydark.mystical.desktop
  else
    echo "Warning: plasma-apply-lookandfeel is unavailable; system-wide defaults were refreshed."
  fi
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kdeglobals --group General --key ColorScheme Mystical
    kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage org.lydark.mystical.desktop
    kwriteconfig6 --file kdeglobals --group Icons --key Theme breeze
    kwriteconfig6 --file kcminputrc --group Mouse --key cursorTheme Mystical
    kwriteconfig6 --file plasmarc --group Theme --key name org.lydark.mystical.desktop
  fi
  local wallpaper="/usr/share/wallpapers/org.lydark.mystical.wallpaper/contents/images/1920x1080.svg"
  if [[ -r "$wallpaper" ]] && command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    plasma-apply-wallpaperimage "$wallpaper" || echo "Warning: wallpaper could not be applied to the current Plasma session."
  fi
  echo
  echo "Mystical theme reapplication is complete. The GRUB/Plymouth setup has been refreshed."
  echo "If the login or boot appearance does not update immediately, reboot to verify it."
}

flatpak_installed() {
  local app_id="$1"
  flatpak list --system --app --columns=application 2>/dev/null | grep -Fxq "$app_id"
}
user_flatpak_installed() {
  local app_id="$1"
  flatpak list --user --app --columns=application 2>/dev/null | grep -Fxq "$app_id"
}
distrobox_exists() {
  command -v distrobox >/dev/null 2>&1 && distrobox list --no-color 2>/dev/null | grep -Fq "$1"
}
feature_enabled() {
  local feature="$1"
  case "$feature" in
    printscan)
      rpm -q cups sane-backends sane-backends-drivers-scanners sane-airscan ipp-usb avahi >/dev/null 2>&1 &&
        flatpak_installed org.kde.skanpage &&
        systemctl is-enabled --quiet cups.service &&
        systemctl is-enabled --quiet avahi-daemon.service ;;
    media)
      flatpak_installed com.spotify.Client &&
        flatpak_installed com.stremio.Stremio &&
        flatpak_installed org.jellyfin.JellyfinDesktop &&
        flatpak_installed com.unicornsonlsd.finamp &&
        flatpak_installed org.fcast.Receiver ;;
    mediaedit)
      flatpak_installed org.inkscape.Inkscape &&
        flatpak_installed org.kde.kdenlive &&
        flatpak_installed org.kde.krita &&
        flatpak_installed ca.littlesvr.asunder &&
        flatpak_installed org.soundconverter.SoundConverter ;;
    gamingui)
      rpm -q steam-devices gamescope >/dev/null 2>&1 &&
        rpm -q steam >/dev/null 2>&1 &&
        [[ -x "$HOME/.local/bin/lyd-gamescope-switch" ]] &&
        [[ -f /usr/share/wayland-sessions/lyd-gamescope.desktop ]] ;;
    gaming)
      rpm -q steam-devices gamemode mangohud gamescope >/dev/null 2>&1 &&
        rpm -q steam >/dev/null 2>&1 &&
        flatpak_installed com.github.Matoking.protontricks &&
        flatpak_installed com.vysp3r.ProtonPlus &&
        flatpak_installed net.lutris.Lutris &&
        flatpak_installed com.heroicgameslauncher.hgl ;;
    steamtheme) return 1 ;;
    8bitdo)
      rpm -q steam-devices >/dev/null 2>&1 &&
        [[ -f /etc/udev/rules.d/71-8bitdo-pro2.rules ]] ;;
    solaar) rpm -q solaar >/dev/null 2>&1 ;;
    devbox) distrobox_exists lyd-atomic-dev ;;
    androiddev)
      { flatpak_installed com.google.AndroidStudio || user_flatpak_installed com.google.AndroidStudio; } &&
        distrobox_exists lyd-android-dev ;;
    container) distrobox_exists lyd-container-dev ;;
    theme)
      { user_flatpak_installed org.inkscape.Inkscape || flatpak_installed org.inkscape.Inkscape; } &&
        { user_flatpak_installed org.kde.krita || flatpak_installed org.kde.krita; } &&
        { user_flatpak_installed org.gimp.GIMP || flatpak_installed org.gimp.GIMP; } &&
        distrobox_exists lyd-theme-dev ;;
    *) return 1 ;;
  esac
}
status_label() {
  local feature="$1" state
  if feature_enabled "$feature"; then state="Enabled"; else state="Disabled"; fi
  printf '\033[35m[%s]\033[0m' "$state"
}
show_feature_group() {
  local heading="$1"
  shift
  local feature state label
  local columns=2
  local terminal_width="${COLUMNS:-}"
  if [[ -z "$terminal_width" ]] && command -v tput >/dev/null 2>&1; then
    terminal_width="$(tput cols 2>/dev/null || true)"
  fi
  if [[ "$terminal_width" =~ ^[0-9]+$ ]]; then
    columns=$((terminal_width / 28))
    (( columns < 1 )) && columns=1
    (( columns > 4 )) && columns=4
  fi

  echo "$heading"
  local index=0
  for feature in "$@"; do
    if feature_enabled "$feature"; then state="Enabled"; else state="Disabled"; fi
    printf -v label '%s [%s]' "$feature" "$state"
    printf '  %-27s' "$label"
    index=$((index + 1))
    if (( index % columns == 0 )); then printf '\n'; fi
  done
  (( index % columns == 0 )) || printf '\n'
}

show_feature_status() {
  show_feature_group "Features:" printscan media mediaedit gaming gamingui steamtheme 8bitdo solaar
  echo
  show_feature_group "Development:" devbox androiddev container theme
}

dev_help() {
  cat <<HELP
Usage:
  lydsetup devbox
  lydsetup dev devbox enable
  lydsetup dev androiddev enable
  lydsetup dev container enable
  lydsetup dev theme enable
  lydsetup development <same subcommands>

Development environments:
  devbox       BlueBuild environment for building Lyd Atomic images and ISOs
  androiddev   Android Studio plus a Fedora Android toolchain container
  container    Fedora container-development tools using host rootless Podman
  theme        KDE theme, icon, cursor and Plymouth artwork toolchain
HELP
}

setup_zed() {
  if command -v zed >/dev/null 2>&1; then
    echo "Zed is already installed. The official installer can update it."
  else
    echo "Zed will be installed in this user's home directory, not layered into the OS."
  fi
  confirm "Run Zed's official stable Linux installer?" || return 0
  curl -f https://zed.dev/install.sh | sh
  echo "Zed installation finished. If needed, add ~/.local/bin to PATH."
}
setup_image_switch() {
  local edition="$1" image="" label="" warning=""
  case "$edition" in
    server)
      image="ghcr.io/lydiaperspective/lyd-atomic-server:latest"
      label="Server"
      warning="This replaces the workstation deployment with the headless Server edition. Plasma and the graphical login will no longer be available after reboot."
      ;;
    workstation|standard)
      image="ghcr.io/lydiaperspective/lyd-atomic-workstation:latest"
      label="KDE Workstation"
      warning="This replaces the current deployment with the complete standard-graphics workstation, including virtualization, development tools and the Mystical theme."
      ;;
    nvidia-gaming|nvidia)
      image="ghcr.io/lydiaperspective/lyd-atomic-nvidia-gaming:latest"
      label="NVIDIA Gaming Workstation"
      warning="This replaces the current deployment with the proprietary NVIDIA 580 gaming workstation, including Steam, launchers, virtualization, development tools and the Mystical theme."
      ;;
    *) die "Usage: lydsetup {server|workstation|nvidia-gaming}" ;;
  esac

  command -v bootc >/dev/null 2>&1 || die "bootc is not available on this system."
  command -v sudo >/dev/null 2>&1 || die "sudo is required."
  echo "You are switching to the Lyd Atomic $label image:"
  echo "  $image"
  echo
  echo "WARNING: $warning"
  echo "The image will be downloaded and staged as the next deployment."
  echo "Your current deployment remains available for rollback."
  echo
  confirm "Continue with the image switch?" || return 0

  echo "Switching to $label..."
  sudo bootc switch "$image"
  echo
  echo "The $label deployment has been staged successfully."
  echo "Reboot when ready to start using it:"
  echo "  systemctl reboot"
}

setup_nvidia() {
  if rpm -q nvidia-driver >/dev/null 2>&1; then
    echo "The NVIDIA edition already includes its prebuilt proprietary driver."
    command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi || true
    return 0
  fi
  require_packages akmod-nvidia xorg-x11-drv-nvidia xorg-x11-drv-nvidia-cuda
  echo "NVIDIA driver packages are included in this image."
  echo "Check module compilation before relying on the driver:"
  echo "  systemctl status akmods"
  echo "  journalctl -u akmods"
  echo "  modinfo -F version nvidia"
}
main() {
  case "${1:-}" in
    server|workstation|standard|nvidia|nvidia-gaming)
      [[ $# -eq 1 ]] || die "Usage: lydsetup {server|workstation|nvidia-gaming}"
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      setup_image_switch "$1"
      exit 0 ;;
    printscan|media|mediaedit|gaming)
      [[ "${2:-}" == "enable" ]] || die "Usage: lydsetup $1 enable"
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      command -v sudo >/dev/null 2>&1 || die "sudo is required."
      case "$1" in
        printscan) setup_printscan ;;
        media) setup_media ;;
        mediaedit) setup_mediaedit ;;
        gaming) setup_gaming ;;
      esac
      exit 0 ;;
    steamtheme)
      [[ $# -eq 1 ]] || die "Usage: lydsetup steamtheme"
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      setup_steamtheme
      exit 0 ;;
    gamingui)
      [[ $# -eq 1 ]] || die "Usage: lydsetup gamingui"
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      command -v sudo >/dev/null 2>&1 || die "sudo is required."
      setup_gamingui
      exit 0 ;;
    8bitdo)
      [[ $# -eq 1 ]] || die "Usage: lydsetup 8bitdo"
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      command -v sudo >/dev/null 2>&1 || die "sudo is required."
      setup_8bitdo
      exit 0 ;;
    solaar)
      [[ "${2:-}" == "enable" ]] || die "Usage: lydsetup solaar enable"
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      command -v sudo >/dev/null 2>&1 || die "sudo is required."
      setup_solaar
      exit 0 ;;
    theme)
      [[ "${2:-}" == "reapply" ]] || die "Usage: lydsetup theme reapply"
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      command -v sudo >/dev/null 2>&1 || die "sudo is required."
      setup_theme_reapply
      exit 0 ;;
    devbox)
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      command -v sudo >/dev/null 2>&1 || die "sudo is required."
      setup_devbox
      exit 0 ;;
    container)
      [[ "${2:-}" == "enable" ]] || die "Usage: lydsetup container enable"
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      command -v sudo >/dev/null 2>&1 || die "sudo is required."
      setup_containerdev
      exit 0 ;;
    androiddev)
      [[ $# -le 1 || "${2:-}" == "enable" ]] || die "Usage: lydsetup androiddev"
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      command -v sudo >/dev/null 2>&1 || die "sudo is required."
      setup_androiddev
      exit 0 ;;
    dev|development)
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      command -v sudo >/dev/null 2>&1 || die "sudo is required."
      case "${2:-}" in
        devbox) [[ "${3:-}" == "enable" ]] || { dev_help; exit 2; }; setup_devbox ;;
        androiddev) [[ "${3:-}" == "enable" ]] || { dev_help; exit 2; }; setup_androiddev ;;
        container) [[ "${3:-}" == "enable" ]] || { dev_help; exit 2; }; setup_containerdev ;;
        theme) [[ "${3:-}" == "enable" ]] || { dev_help; exit 2; }; setup_themedev ;;
        --help|-h|"") dev_help ;;
        *) dev_help; die "Unknown development environment: $2" ;;
      esac
      exit 0 ;;
    --help|-h)
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      echo "Current feature status (purple):"
      show_feature_status
      echo
      cat <<HELP
lydsetup $VERSION
Optional-feature manager for Lyd Atomic.

Usage: lydsetup [server|workstation|nvidia-gaming|media enable|mediaedit enable|printscan enable|gaming enable|gamingui|steamtheme|8bitdo|solaar enable|container enable|androiddev|theme reapply|dev|development|devbox ...]

Available commands:
  lydsetup server                      Switch to the headless Server image
  lydsetup workstation                 Switch to the Standard KDE workstation image
  lydsetup nvidia                      Switch to the NVIDIA KDE workstation image
  lydsetup steam                       Switch to the Standard KDE + Steam/Gamescope image
  lydsetup nvidia-steam                Switch to the NVIDIA KDE + Steam/Gamescope image
  lydsetup                              Show this command list
  lydsetup --help                       Show this command list
  lydsetup --version                    Show version
  lydsetup printscan enable             Enable printing/scanning and install Skanpage
  lydsetup media enable                 Install media playback Flatpaks
  lydsetup mediaedit enable             Install media editing/conversion Flatpaks
  lydsetup gaming enable                Verify and refresh the preinstalled gaming launchers
  lydsetup gamingui                     Configure the Steam Gamescope session menu shortcut
  lydsetup steamtheme                   Check Lyd Mystical theme support for system Steam
  lydsetup 8bitdo                       Configure preinstalled Steam device support and 8BitDo Pro 2 udev permissions
  lydsetup solaar enable                Use preinstalled Solaar system-wide
  lydsetup devbox                       Set up BlueBuild image/ISO Distrobox
  lydsetup container enable             Set up Fedora container-development tools
  lydsetup androiddev                   Set up Android Studio and Android toolchain
  lydsetup dev devbox enable            Same as above
  lydsetup dev androiddev enable        Set up Android Studio development
  lydsetup dev container enable        Set up Podman container development
  lydsetup dev theme enable            Set up KDE theme/icon/cursor/Plymouth development
  Use 'development' instead of 'dev' as an alias for development commands.

Running lydsetup without arguments displays this list instead of opening the
interactive feature menu. Run lydsetup with an explicit feature command to set it up.

Features:
  NVIDIA proprietary driver packages (preinstalled; standard edition)
  Virtualization (preinstalled on complete workstation and server images)
  CoolerControl system package and daemon
  TuneD + tuned-ppd (replaces power-profiles-daemon)
  Tailscale VPN client (preinstalled; all editions)
  Zed editor (official per-user Linux installer; workstation editions)
  BlueBuild development environment (Distrobox; all editions)
  Solaar Logitech device manager (preinstalled system package)
  Printing and scanning (preinstalled and enabled on workstation base images)
  Media apps (Spotify, Stremio, Jellyfin Desktop, Finamp and FCast Receiver)
  Gaming (NVIDIA Gaming Workstation includes Steam, GameMode, MangoHud, Gamescope, Lutris, Heroic and ProtonPlus)

Image switching downloads and stages the selected bootc image; reboot to activate it.\nAll system RPMs are included in the image; lydsetup only enables and configures features.
NVIDIA module compilation may take several minutes. Secure Boot may require
separate module-signing setup before the driver can load.
Logs: $LOG
HELP
      exit 0 ;;
    --version) echo "$VERSION"; exit 0 ;;
    "")
      [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
      show_feature_status
      echo
      echo "Run lydsetup --help to see available commands."
      exit 0 ;;
    *) die "Unknown argument: $1 (try --help)" ;;
  esac
  [[ $EUID -ne 0 ]] || die "Run lydsetup as your regular user, not with sudo."
  command -v sudo >/dev/null 2>&1 || die "sudo is required."
  local server_edition=0
  rpm -q cockpit-machines >/dev/null 2>&1 && server_edition=1
  while true; do
    echo
    echo "  Lyd Atomic setup"
    echo "  ----------------"
    if (( server_edition )); then
      echo "  1) Virtualization (QEMU/KVM + libvirt)"
      echo "  2) CoolerControl"
      echo "  3) TuneD + tuned-ppd"
      echo "  4) Tailscale VPN"
      echo "  5) BlueBuild development environment (Distrobox)"
      echo "  6) Solaar (Logitech device manager)"
      echo "  7) Exit"
    else
      echo "  1) NVIDIA proprietary driver"
      echo "  2) Virtualization (QEMU/KVM + libvirt)"
      echo "  3) CoolerControl"
      echo "  4) TuneD + tuned-ppd"
      echo "  5) Tailscale VPN"
      echo "  6) Zed editor"
      echo "  7) BlueBuild development environment (Distrobox)"
      echo "  8) Solaar (Logitech device manager)"
      echo "  9) Exit"
    fi
    read -r -p "Select a feature: " choice
    if (( server_edition )); then
      case "$choice" in
        1) setup_virtualization ;;
        2) setup_coolercontrol ;;
        3) setup_tuned ;;
        4) setup_tailscale ;;
        5) setup_devbox ;;
        6) setup_solaar ;;
        7) break ;;
        *) echo "Choose a listed number." ;;
      esac
    else
      case "$choice" in
        1) setup_nvidia ;;
        2) setup_virtualization ;;
        3) setup_coolercontrol ;;
        4) setup_tuned ;;
        5) setup_tailscale ;;
        6) setup_zed ;;
        7) setup_devbox ;;
        8) setup_solaar ;;
        9) break ;;
        *) echo "Choose a listed number." ;;
      esac
    fi
  done
  echo "lydsetup finished. Log: $LOG"
}
main "$@"
