#!/usr/bin/env bash
# Lyd Atomic system and application management.
set -Eeuo pipefail

VERSION="1.5.2"

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
need_user() { [[ $EUID -ne 0 ]] || die "Run lydmanage as your regular user, not with sudo."; }
need_root() { [[ $EUID -eq 0 ]] || die "This internal operation must run as root."; }
need_sudo() { command -v sudo >/dev/null 2>&1 || die "sudo is required."; }
confirm() {
  local answer
  read -r -p "$1 [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]]
}
require_bootc() {
  command -v bootc >/dev/null 2>&1 || die "bootc is unavailable. This command requires a Lyd Atomic bootc installation."
}

resolve_image() {
  case "$1" in
    workstation|standard)
      printf '%s\n' "ghcr.io/lydiaperspective/lyd-atomic-workstation:latest" ;;
    nvidia-gaming|nvidia)
      printf '%s\n' "ghcr.io/lydiaperspective/lyd-atomic-nvidia-gaming:latest" ;;
    server)
      printf '%s\n' "ghcr.io/lydiaperspective/lyd-atomic-server:latest" ;;
    base)
      printf '%s\n' "ghcr.io/lydiaperspective/lyd-atomic-base:latest" ;;
    nvidia-base)
      printf '%s\n' "ghcr.io/lydiaperspective/lyd-atomic-nvidia:latest" ;;
    nvidia-open)
      printf '%s\n' "ghcr.io/lydiaperspective/lyd-atomic-nvidia-open:latest" ;;
    *)
      [[ "$1" != -* && "$1" =~ ^[A-Za-z0-9._:/@+-]+$ ]] ||
        die "Invalid image reference. Use an image alias or a full OCI image reference."
      printf '%s\n' "$1"
      ;;
  esac
}

switch_image() {
  need_user
  require_bootc
  need_sudo
  [[ $# -eq 1 ]] || die "Usage: lydmanage switch <newImage>"
  local image
  image="$(resolve_image "$1")"
  echo "Target image: $image"
  echo "bootc will download and stage this image as the next deployment."
  echo "Your current deployment remains available for rollback."
  confirm "Switch to this image?" || { echo "Cancelled."; return 0; }
  sudo bootc switch "$image"
  echo
  echo "Image switch staged. Reboot when ready to use it:"
  echo "  systemctl reboot"
}

system_update() {
  need_user
  require_bootc
  need_sudo
  echo "Checking the configured image source and staging any available update..."
  echo "The running system will not be changed. Reboot to activate the staged deployment."
  sudo bootc update
}

system_status() {
  require_bootc
  bootc status
}

systemd_reload() {
  need_user
  need_sudo
  echo "Reloading systemd unit files and generated configuration..."
  sudo systemctl daemon-reload
  echo "Systemd manager configuration reloaded."
}

system_rollback() {
  need_user
  require_bootc
  need_sudo
  echo "This stages the previous bootc deployment for the next boot."
  confirm "Prepare rollback?" || { echo "Cancelled."; return 0; }
  sudo bootc rollback
  echo "Rollback staged. Reboot to activate it."
}

flatpak_update() {
  command -v flatpak >/dev/null 2>&1 || { echo "Flatpak is not installed; skipping."; return 0; }
  echo "Updating Flatpak applications..."
  flatpak update --assumeyes
}

flatpak_file() {
  local path="${1:-flatpak-apps.txt}"
  [[ "$path" != -* ]] || die "File paths must not begin with '-'."
  printf '%s\n' "$path"
}

flatpak_save() {
  need_user
  command -v flatpak >/dev/null 2>&1 || die "Flatpak is not installed."
  [[ $# -le 1 ]] || die "Usage: lydmanage flatpak save [file]"
  local output tmp
  output="$(flatpak_file "${1:-flatpak-apps.txt}")"
  tmp="$(mktemp "${output}.XXXXXX")"
  {
    echo "# Lyd Atomic Flatpak application list v1"
    echo "# Application IDs; restore installs from Flathub."
    flatpak list --app --columns=application |
      awk '/^[[:alnum:]][[:alnum:]._-]*$/ { print }' |
      sort -u
  } > "$tmp"
  mv -- "$tmp" "$output"
  echo "Saved installed Flatpak application IDs to: $output"
}

flatpak_load() {
  need_user
  command -v flatpak >/dev/null 2>&1 || die "Flatpak is not installed."
  [[ $# -le 1 ]] || die "Usage: lydmanage flatpak load [file]"
  local input app_id failures=0 installed=0 skipped=0
  input="$(flatpak_file "${1:-flatpak-apps.txt}")"
  [[ -r "$input" ]] || die "Cannot read Flatpak list: $input"

  # Use a per-user Flathub remote so restoring the list never requires root.
  flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

  while IFS= read -r app_id || [[ -n "$app_id" ]]; do
    [[ -z "$app_id" || "$app_id" == \#* ]] && continue
    [[ "$app_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
      echo "Skipping invalid application ID: $app_id" >&2
      failures=$((failures + 1))
      continue
    }
    if flatpak info --user "$app_id" >/dev/null 2>&1 ||
       flatpak info --system "$app_id" >/dev/null 2>&1; then
      echo "Already installed: $app_id"
      skipped=$((skipped + 1))
      continue
    fi
    echo "Installing: $app_id"
    if flatpak install --user --assumeyes --noninteractive flathub "$app_id"; then
      installed=$((installed + 1))
    else
      echo "Failed to install: $app_id" >&2
      failures=$((failures + 1))
    fi
  done < "$input"

  echo "Flatpak restore complete: $installed installed, $skipped already present, $failures failed."
  (( failures == 0 )) || return 1
}

plasma_profile_file() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "Profile names may contain only letters, numbers, dots, underscores and hyphens."
  [[ "$name" == *.conf ]] || name="${name}.conf"
  printf '%s\n' "$name"
}

plasma_save() {
  need_user
  [[ $# -eq 1 ]] || die "Usage: lydmanage plasma save <profilename>"
  local output source tmp
  output="$(plasma_profile_file "$1")"
  source="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
  [[ -s "$source" ]] || die "Plasma layout file was not found: $source. Run this command from your Plasma desktop session."
  tmp="$(mktemp "${output}.XXXXXX")"
  {
    echo "# Lyd Atomic Plasma layout profile v1"
    echo "# Contains Plasma panels, widgets and their configuration."
    base64 -w 76 "$source"
  } > "$tmp"
  mv -- "$tmp" "$output"
  echo "Saved Plasma layout and widget settings to: $output"
}

plasma_load() {
  need_user
  [[ $# -eq 1 ]] || die "Usage: lydmanage plasma load <profilename>"
  local input target tmp
  input="$(plasma_profile_file "$1")"
  [[ -r "$input" ]] || die "Cannot read Plasma profile: $input"
  local header
  IFS= read -r header < "$input"
  [[ "$header" == "# Lyd Atomic Plasma layout profile v1" ]] ||
    die "Unsupported or invalid Plasma profile: $input"

  target="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
  install -d "$(dirname "$target")"
  tmp="$(mktemp "${target}.XXXXXX")"
  if ! tail -n +3 "$input" | base64 --decode > "$tmp"; then
    rm -f "$tmp"
    die "Could not decode Plasma profile: $input"
  fi
  if ! grep -q '^\[Containments\]' "$tmp"; then
    rm -f "$tmp"
    die "The profile does not contain a valid Plasma layout."
  fi
  chmod 0600 "$tmp"
  mv -- "$tmp" "$target"
  echo "Restored Plasma layout and widget settings from: $input"

  if command -v plasmashell >/dev/null 2>&1 && command -v kquitapp6 >/dev/null 2>&1; then
    kquitapp6 plasmashell >/dev/null 2>&1 || true
    nohup plasmashell --replace >/dev/null 2>&1 </dev/null &
    echo "Restarted Plasma Shell to apply the profile."
  else
    echo "Log out and back in to apply the restored Plasma layout."
  fi
}


pods_move() {
  need_user
  need_sudo
  [[ $# -eq 3 && "$2" == "mv" ]] || die "Usage: lydmanage pods <Media|Pictures|Backups|Storage|Config> mv <newMountLocation>"
  local folder="$1" destination="$3" source="/lydsrv/$1"
  case "$folder" in Media|Pictures|Backups|Storage|Config) ;; *) die "Unknown standardized folder: $folder" ;; esac
  [[ "$destination" == /* && "$destination" != "/" ]] || die "Destination must be an absolute path."
  [[ "$destination" != *"/../"* && "$destination" != */.. && "$destination" != *"/./"* ]] || die "Destination must not contain . or .. path components."
  [[ ! -L "$source" && -d "$source" ]] || die "$source must currently be a real directory, not a symlink."
  [[ -d "$(dirname "$destination")" ]] || die "Destination parent directory does not exist."
  [[ ! -e "$destination" ]] || die "Destination already exists: $destination"
  [[ "$destination" == /lydsrv/Mnt/* ]] || die "Destination must be under /lydsrv/Mnt/<diskMountFolderName>/."
  local destination_relative="${destination#/lydsrv/Mnt/}"
  [[ "$destination_relative" == */* ]] || die "Destination must be a folder inside a named drive mount directory."
  local disk_root="/lydsrv/Mnt/${destination_relative%%/*}"
  [[ -d "$disk_root" ]] || die "Drive mount directory does not exist: $disk_root"
  [[ "$destination" == "$disk_root/"* ]] || die "Destination must be inside the selected drive mount."
  mountpoint -q "$disk_root" || die "$disk_root is not an active mount point. Mount the drive through Cockpit first."
  [[ -w "$disk_root" ]] || die "You do not have write access to $disk_root. Configure the drive mount permissions for the server administrator first."

  local admin
  admin="$(sudo cat /var/lib/lyd/admin-user 2>/dev/null || true)"
  [[ "$admin" == "$USER" ]] || die "Only the install-time storage administrator ('$admin') can move standardized storage folders."

  local ids=() running=() id inspect source_path running_state
  command -v podman >/dev/null 2>&1 || die "Podman is not installed."
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    inspect="$(podman inspect "$id")"
    if jq -e --arg src "$source" '.[0].Mounts[]? | select(.Type == "bind" and (.Source == $src or (.Source | startswith($src + "/"))))' <<< "$inspect" >/dev/null; then
      ids+=("$id")
      running_state="$(jq -r '.[0].State.Running' <<< "$inspect")"
      [[ "$running_state" == true ]] && running+=("$id")
    fi
  done < <(podman ps -aq)

  echo "This will move $source to $destination."
  echo "Containers using this folder: ${#ids[@]} (running: ${#running[@]})."
  confirm "Stop affected containers, move the data and restart them?" || { echo "Cancelled."; return 0; }

  local stopped=() id
  for id in "${running[@]}"; do
    podman stop "$id" >/dev/null
    stopped+=("$id")
  done

  local failed=0
  if ! install -d -m 2775 "$destination"; then
    failed=1
  elif ! cp -a --no-preserve=ownership "$source/." "$destination/"; then
    failed=1
  fi
  if (( failed )); then
    echo "Data copy failed. Original data remains at $source; attempting to restart stopped containers." >&2
    for id in "${stopped[@]}"; do podman start "$id" >/dev/null || true; done
    die "Storage move aborted."
  fi

  # Ensure the install administrator owns the copied tree for rootless Podman.
  if ! sudo chown -R "$USER:$(id -gn)" "$destination"; then
    echo "Could not set destination ownership. Original data remains intact." >&2
    for id in "${stopped[@]}"; do podman start "$id" >/dev/null || true; done
    die "Storage move aborted."
  fi

  local backup="${source}.lyd-move-backup-$(date +%Y%m%d%H%M%S)"
  if ! mv "$source" "$backup" || ! ln -s "$destination" "$source"; then
    echo "Could not switch standardized folder to the new location. Data backup is at $backup." >&2
    for id in "${stopped[@]}"; do podman start "$id" >/dev/null || true; done
    die "Storage move incomplete; manual recovery may be required."
  fi
  echo "Original directory retained as: $backup"
  for id in "${stopped[@]}"; do
    podman start "$id" >/dev/null || { echo "Warning: could not restart container $id." >&2; failed=1; }
  done
  (( failed == 0 )) || die "Storage moved, but one or more containers did not restart."
  echo "$source now points to $destination."
}


drive_target() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "Invalid drive mount name."
  printf '/lydsrv/Mnt/%s\n' "$1"
}
drive_list() {
  need_user
  local src target fs opts status found=0
  printf '%-18s %-28s %-10s %s\n' NAME DEVICE TYPE STATUS
  while read -r src target fs opts; do
    [[ "$target" == /lydsrv/Mnt/* && "$target" != /lydsrv/Mnt/*/* ]] || continue
    found=1
    if findmnt -rn -M "$target" >/dev/null 2>&1; then status=mounted; else status=unmounted; fi
    [[ ",$opts," == *,x-systemd.automount,* ]] && status="$status (automount)"
    printf '%-18s %-28s %-10s %s\n' "\${target##*/}" "$src" "$fs" "$status"
  done < <(awk '!/^[[:space:]]*#/ && NF >= 4 {print $1,$2,$3,$4}' /etc/fstab)
  (( found )) || echo "No Lyd-managed drives configured."
}
drive_add() {
  need_user
  need_sudo
  command -v jq >/dev/null 2>&1 || die "jq is required."
  local -a rows=()
  local row dev uuid fs label size choice name target auto opts uid gid admin
  while IFS= read -r row; do rows+=("$row"); done < <(
    lsblk --json --paths --output NAME,TYPE,SIZE,FSTYPE,LABEL,UUID,MOUNTPOINTS |
      jq -r '.blockdevices[] as $d | ($d.children // [])[] | select(.type=="part" and .uuid!=null and .fstype!=null and ((.mountpoints // [])|all(.==null))) | [.name,.uuid,.fstype,(.label // "-"),.size] | @tsv'
  )
  (("${#rows[@]}" > 0)) || die "No unmounted, formatted partitions with UUIDs found. Nothing will be formatted."
  echo "Available existing partitions (no formatting or erasing):"
  local i=1
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r dev uuid fs label size <<< "$row"
    printf ' %d) %s  %s  %s  %s  UUID=%s\n' "$i" "$dev" "$size" "$fs" "$label" "$uuid"
    ((i+=1))
  done
  read -r -p "Choose a partition number: " choice
  [[ "$choice" =~ ^[0-9]+$ ]] && ((choice>=1 && choice<=${#rows[@]})) || die "Invalid selection."
  IFS=$'\t' read -r dev uuid fs label size <<< "${rows[$((choice-1))]}"
  read -r -p "Mount folder name under /lydsrv/Mnt: " name
  target="$(drive_target "$name")"
  [[ ! -e "$target" && ! -L "$target" ]] || die "Mount path already exists."
  awk -v t="$target" '$2==t {found=1} END {exit !found}' /etc/fstab && die "Mount path already configured."
  awk -v u="UUID=$uuid" '$1==u {found=1} END {exit !found}' /etc/fstab && die "Filesystem UUID already configured."
  read -r -p "Enable systemd automount when the path is accessed? [y/N] " auto
  admin="$(sudo cat /var/lib/lyd/admin-user 2>/dev/null || true)"
  [[ "$admin" == "$USER" ]] || die "Only the recorded storage administrator can add drives."
  uid="$(id -u "$USER")"
  gid="$(id -g "$USER")"
  case "$fs" in
    vfat|fat|msdos) opts="uid=$uid,gid=$gid,umask=002" ;;
    exfat|ntfs|ntfs3) opts="uid=$uid,gid=$gid,fmask=0002,dmask=0002" ;;
    *) opts=defaults ;;
  esac
  if [[ "$auto" =~ ^[Yy]$ ]]; then
    opts="$opts,x-systemd.automount,nofail,x-systemd.device-timeout=10s"
  else
    opts="$opts,noauto,nofail"
  fi
  printf 'Device: %s\nFilesystem: %s\nUUID: %s\nMount path: %s\nAutomount: %s\n' "$dev" "$fs" "$uuid" "$target" "$([[ "$auto" =~ ^[Yy]$ ]] && echo yes || echo no)"
  confirm "Add this existing filesystem without formatting it?" || { echo "Cancelled."; return 0; }
  sudo install -d -o "$uid" -g "$gid" -m 2775 "$target"
  sudo cp -a /etc/fstab "/etc/fstab.lyd-backup.$(date +%Y%m%d%H%M%S)"
  printf 'UUID=%s %s %s %s 0 2\n' "$uuid" "$target" "$fs" "$opts" | sudo tee -a /etc/fstab >/dev/null
  sudo systemctl daemon-reload
  if [[ "$auto" =~ ^[Yy]$ ]]; then
    sudo mount "$target" || die "Mount failed; fstab entry retained for troubleshooting."
    case "$fs" in
      vfat|fat|msdos|exfat|ntfs|ntfs3) ;;
      *) sudo chown "$uid:$gid" "$target"; sudo chmod 2775 "$target" ;;
    esac
    echo "Drive added and mounted at $target."
  else
    echo "Drive configured. Mount it with: sudo mount $target"
  fi
  echo "Existing contents and file ownership were not recursively changed."
}
drive_entry() {
  awk -v t="$1" '!/^[[:space:]]*#/ && $2==t {print $1,$2,$3,$4; found=1} END {if(!found) exit 1}' /etc/fstab
}
drive_umount() {
  need_user; need_sudo
  [[ $# -eq 1 ]] || die "Usage: lydmanage drives umount <name>"
  local target
  target="$(drive_target "$1")"; drive_entry "$target" >/dev/null || die "No configured drive named $1."
  if findmnt -rn -M "$target" >/dev/null 2>&1; then sudo umount -- "$target" || die "Could not unmount $target; check processes using it."; else echo "Already unmounted."; fi
}
drive_rm() {
  need_user; need_sudo
  [[ $# -eq 1 ]] || die "Usage: lydmanage drives rm <name>"
  local target tmp unit
  target="$(drive_target "$1")"; drive_entry "$target" >/dev/null || die "No configured drive named $1."
  confirm "Remove $target from /etc/fstab? Drive data will remain untouched." || return 0
  unit="$(systemd-escape --path --suffix=automount "$target")"
  sudo systemctl stop "$unit" 2>/dev/null || true
  if findmnt -rn -M "$target" >/dev/null 2>&1; then sudo umount -- "$target" || die "Could not unmount $target."; fi
  tmp="$(mktemp)"; awk -v t="$target" '/^[[:space:]]*#/ || $2!=t {print}' /etc/fstab > "$tmp"
  sudo cp -a /etc/fstab "/etc/fstab.lyd-backup.$(date +%Y%m%d%H%M%S)"
  sudo install -m 0644 "$tmp" /etc/fstab; rm -f "$tmp"; sudo systemctl daemon-reload
  rmdir "$target" 2>/dev/null || echo "Mount directory retained because it is not empty."
  echo "Configuration removed; drive contents were not deleted."
}
drive_edit() {
  need_user; need_sudo
  [[ $# -eq 1 ]] || die "Usage: lydmanage drives edit <name>"
  local old entry src fs opts uuid name new auto newopts tmp was=0
  old="$(drive_target "$1")"; entry="$(drive_entry "$old")" || die "No configured drive named $1."
  read -r src _ fs opts <<< "$entry"; uuid="${src#UUID=}"
  read -r -p "New mount folder name (blank keeps '$1'): " name; [[ -n "$name" ]] || name="$1"
  new="$(drive_target "$name")"
  [[ "$new" == "$old" || ( ! -e "$new" && ! -L "$new" ) ]] || die "New mount path already exists."
  read -r -p "Enable systemd automount? [y/N] " auto
  newopts="$opts"; newopts="${newopts//,x-systemd.automount/}"; newopts="${newopts//,noauto/}"; newopts="${newopts//,nofail/}"; newopts="${newopts//,x-systemd.device-timeout=10s/}"
  if [[ "$auto" =~ ^[Yy]$ ]]; then newopts="$newopts,x-systemd.automount,nofail,x-systemd.device-timeout=10s"; else newopts="$newopts,noauto,nofail"; fi
  confirm "Change mount to $new with automount $([[ "$auto" =~ ^[Yy]$ ]] && echo enabled || echo disabled)?" || return 0
  if findmnt -rn -M "$old" >/dev/null 2>&1; then was=1; sudo umount "$old" || die "Could not unmount $old."; fi
  sudo install -d -m 2775 "$new"
  tmp="$(mktemp)"; awk -v t="$old" '$2!=t {print}' /etc/fstab > "$tmp"
  printf 'UUID=%s %s %s %s 0 2\n' "$uuid" "$new" "$fs" "$newopts" >> "$tmp"
  sudo cp -a /etc/fstab "/etc/fstab.lyd-backup.$(date +%Y%m%d%H%M%S)"
  sudo install -m 0644 "$tmp" /etc/fstab; rm -f "$tmp"; sudo systemctl daemon-reload
  [[ "$old" == "$new" ]] || rmdir "$old" 2>/dev/null || true
  if [[ "$auto" =~ ^[Yy]$ || "$was" == 1 ]]; then sudo mount "$new" || die "Configuration saved but mount failed."; fi
  echo "Drive configuration updated."
}
drive_command() {
  case "${1:-}" in
    add) [[ $# -eq 1 ]] || die "Usage: lydmanage drives add"; drive_add ;;
    list) [[ $# -eq 1 ]] || die "Usage: lydmanage drives list"; drive_list ;;
    umount) shift; drive_umount "$@" ;;
    rm) shift; drive_rm "$@" ;;
    edit) shift; drive_edit "$@" ;;
    *) die "Usage: lydmanage drives {add|list|umount|rm|edit}" ;;
  esac
}
lact_enable() {
  need_user
  need_sudo
  command -v lact >/dev/null 2>&1 || die "LACT is not installed. This command is available on NVIDIA images."
  systemctl cat lactd.service >/dev/null 2>&1 || die "The lactd.service unit is not installed."
  echo "Enabling and starting the LACT GPU management daemon."
  sudo systemctl enable --now lactd.service
  echo "LACT is enabled and running. It will start automatically on future boots."
}
firmware_update() {
  command -v fwupdmgr >/dev/null 2>&1 || die "fwupdmgr is not installed."
  need_sudo
  echo "Refreshing firmware metadata from configured remotes..."
  sudo fwupdmgr refresh --force
  echo "Checking for and installing available firmware updates..."
  sudo fwupdmgr update
}
auto_enable() {
  need_user
  need_sudo
  echo "Enabling weekly automatic updates (Sunday at 03:00 local system time)."
  echo "The built-in bootc timer will be disabled so system updates follow this schedule."
  sudo systemctl daemon-reload
  sudo systemctl disable --now bootc-fetch-apply-updates.timer 2>/dev/null || true
  sudo systemctl enable --now lydmanage-updates.timer
  echo "Automatic updates are enabled. The computer will not reboot automatically."
}

auto_disable() {
  need_user
  need_sudo
  sudo systemctl disable --now lydmanage-updates.timer
  sudo systemctl disable --now bootc-fetch-apply-updates.timer 2>/dev/null || true
  echo "Automatic updates are disabled. Manual updates remain available."
}

auto_status() {
  if systemctl is-enabled --quiet lydmanage-updates.timer 2>/dev/null; then
    echo "Automatic updates: enabled"
  else
    echo "Automatic updates: disabled"
  fi
  systemctl list-timers lydmanage-updates.timer --no-pager 2>/dev/null || true
}

run_automatic_updates() {
  need_root
  local failures=0
  echo "===== Lyd Atomic scheduled updates: $(date --iso-8601=seconds) ====="

  if command -v flatpak >/dev/null 2>&1; then
    echo "===== Flatpak system updates ====="
    flatpak update --system --assumeyes || { echo "Flatpak system update failed."; failures=$((failures + 1)); }
  fi

  if command -v bootc >/dev/null 2>&1; then
    echo "===== bootc image update ====="
    if bootc update; then
      systemctl daemon-reload || { echo "systemd daemon-reload failed."; failures=$((failures + 1)); }
    else
      echo "bootc update failed."
      failures=$((failures + 1))
    fi
  fi

  if command -v fwupdmgr >/dev/null 2>&1; then
    echo "===== Firmware updates ====="
    fwupdmgr refresh --force || { echo "Firmware metadata refresh failed."; failures=$((failures + 1)); }
    fwupdmgr update --assume-yes || { echo "Firmware update failed."; failures=$((failures + 1)); }
  fi

  echo "===== Scheduled update run complete ====="
  if (( failures > 0 )); then
    echo "$failures update task(s) failed. Review: journalctl -u lydmanage-updates.service"
    return 1
  fi
  echo "All available update tasks completed."
}
usage() {
  cat <<HELP
lydmanage $VERSION

Usage:
  lydmanage switch <newImage>       Switch to another bootc image
  lydmanage update                  Run bootc update and stage the latest image
  lydmanage status                  Show current, staged and rollback deployments
  lydmanage systemd reload          Reload systemd unit files and generated configuration
  lydmanage rollback                Stage the previous deployment for rollback
  lydmanage plasma save <profile>   Save Plasma panels, widgets and layout
  lydmanage plasma load <profile>   Restore a saved Plasma layout profile
  lydmanage flatpak save [file]     Save installed Flatpak application IDs
  lydmanage flatpak load [file]     Install apps from a saved Flatpak list
  lydmanage flatpak update          Update installed Flatpak applications
  lydmanage firmware update        Refresh and install available firmware updates
  lydmanage lact enable            Enable and start the LACT daemon (NVIDIA images)
  lydmanage pods <folder> mv <path> Move standardized server storage to a mounted drive
  lydmanage updates auto enable     Enable weekly automatic updates
  lydmanage updates auto disable    Disable weekly automatic updates
  lydmanage updates auto status     Show automatic update timer status

Image aliases:
  workstation, nvidia-gaming, server
  base, nvidia-base, nvidia-open

Profile and Flatpak list files are written in the current directory by default.
Flatpak restore installs missing applications from Flathub in the user installation.

Short alias:
  lydm <same arguments>

Scheduled update logs:
  journalctl -u lydmanage-updates.service
HELP
}
main() {
  case "${1:-}" in
    switch)
      shift
      switch_image "$@"
      ;;
    update)
      [[ $# -eq 1 ]] || die "Usage: lydmanage update"
      system_update
      ;;
    status)
      [[ $# -eq 1 ]] || die "Usage: lydmanage status"
      system_status
      ;;
    systemd)
      [[ "${2:-}" == "reload" && $# -eq 2 ]] || die "Usage: lydmanage systemd reload"
      systemd_reload
      ;;
    rollback)
      [[ $# -eq 1 ]] || die "Usage: lydmanage rollback"
      system_rollback
      ;;
    plasma)
      case "${2:-}" in
        save) shift 2; plasma_save "$@" ;;
        load) shift 2; plasma_load "$@" ;;
        *) die "Usage: lydmanage plasma {save|load} <profilename>" ;;
      esac
      ;;
    flatpak)
      case "${2:-}" in
        update) [[ $# -eq 2 ]] || die "Usage: lydmanage flatpak update"; need_user; flatpak_update ;;
        save) shift 2; flatpak_save "$@" ;;
        load) shift 2; flatpak_load "$@" ;;
        *) die "Usage: lydmanage flatpak {save|load|update} [file]" ;;
      esac
      ;;
    lact)
      [[ "${2:-}" == "enable" && $# -eq 2 ]] || die "Usage: lydmanage lact enable"
      lact_enable
      ;;
    firmware)
      need_user
      [[ "${2:-}" == "update" && $# -eq 2 ]] || die "Usage: lydmanage firmware update"
      firmware_update
      ;;
    updates)
      case "${2:-}" in
        auto)
          case "${3:-}" in
            enable) [[ $# -eq 3 ]] || die "Usage: lydmanage updates auto enable"; auto_enable ;;
            disable) [[ $# -eq 3 ]] || die "Usage: lydmanage updates auto disable"; auto_disable ;;
            status) [[ $# -eq 3 ]] || die "Usage: lydmanage updates auto status"; auto_status ;;
            *) die "Usage: lydmanage updates auto {enable|disable|status}" ;;
          esac
          ;;
        run)
          [[ $# -eq 2 ]] || die "Invalid internal update invocation."
          run_automatic_updates
          ;;
        *) die "Usage: lydmanage updates auto {enable|disable|status}" ;;
      esac
      ;;
    --help|-h|"") usage ;;
    --version) echo "lydmanage $VERSION" ;;
    *) usage >&2; die "Unknown command: $1" ;;
  esac
}

main "$@"

