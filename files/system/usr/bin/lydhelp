#!/usr/bin/env bash
set -Eeuo pipefail
VERSION="1.0.0"
topic="${1:-help}"
show_index() {
  cat <<'EOF'
lydhelp - a practical Linux command reference

Usage:
  lydhelp                 Show this index
  lydhelp files           Copy, move and inspect files
  lydhelp folders         Create, remove and navigate directories
  lydhelp search          Find files and search text
  lydhelp permissions     Understand ownership and permissions
  lydhelp storage         Inspect disks, filesystems and mounts
  lydhelp processes       Inspect and manage processes
  lydhelp network         Inspect network connections
  lydhelp packages        Inspect image packages and deployments
  lydhelp flatpak         Manage Flatpak applications
  lydhelp appimage        Run and troubleshoot AppImage applications
  lydhelp archives        Create and extract archives
  lydhelp atomic          Understand bootc updates, image switching and rollbacks
  lydhelp manage          Manage Lyd Atomic images and system updates
  lydmanage update         Stage the latest operating-system image update
  lydmanage switch IMAGE   Switch to another bootc image
  lydmanage status         Show current and staged deployments
  lydm                    Short alias for lydmanage
  lydsetup                Configure services and firewall rules (see lydsetup firewall)
  lydsetup firewall       List firewall subcommands and usage
  lydsetup tailscale      List Tailscale setup commands
  lydsetup sunshine       Enable or disable Sunshine streaming
  lydsetup networkshare   Set up or disable a Samba/NFS network share
  lydmanage plasma save PROFILE   Save Plasma panels and widgets
  lydmanage plasma load PROFILE   Restore a saved Plasma layout
  lydmanage flatpak save          Export installed Flatpak application IDs
  lydmanage flatpak load          Install apps from a saved Flatpak list
  lydev                   Enter the BlueBuild development Distrobox

Tip: use 'command --help' or 'man command' for complete documentation.
EOF
}
case "$topic" in
--version|-V) echo "lydhelp $VERSION" ;;
help|--help|-h) show_index ;;
files) cat <<'EOF'
FILES
  ls -lah FILE       List files, including hidden files, in long format
  file FILE          Identify a file's type
  stat FILE          Show detailed file metadata
  cp SOURCE DEST     Copy a file; add -r for directories
  mv SOURCE DEST     Move or rename a file
  rm FILE            Remove a file; use -r for directories (be careful)
  touch FILE         Create an empty file or update its timestamp
  head -n 20 FILE    Show the first 20 lines
  tail -n 20 FILE    Show the last 20 lines
  less FILE          Read a file interactively; press q to quit
EOF
;;
folders) cat <<'EOF'
FOLDERS
  pwd                Print the current working directory
  cd PATH            Change directory; cd .. moves to the parent
  mkdir NAME         Create a directory; mkdir -p creates parent paths too
  rmdir NAME         Remove an empty directory
  find PATH -type d  Find directories below PATH
  du -sh PATH        Show total space used by a directory
  tree PATH          Display a directory tree (install tree if needed)
EOF
;;
search) cat <<'EOF'
SEARCH
  find PATH -name '*.txt'     Find matching filenames
  grep -n 'text' FILE         Search text and show line numbers
  grep -Rni 'text' PATH       Search recursively, case-insensitively
  command -v PROGRAM          Find a command in PATH
  whereis PROGRAM             Find a program's binary and manual
  rg 'text' PATH              Fast recursive text search (ripgrep)
EOF
;;
permissions) cat <<'EOF'
PERMISSIONS
  ls -l FILE             Show owner, group and rwx permissions
  id                     Show your user and group IDs
  groups                 List your group memberships
  chmod 644 FILE         Owner can write; everyone can read
  chmod 755 FILE         Owner can write/execute; everyone can read/execute
  chmod +x FILE          Add execute permission
  chown USER:GROUP FILE  Change owner and group (normally requires sudo)
  umask                  Show default permission mask for new files
  NOTE: avoid chmod -R 777; it makes files writable by everyone.
EOF
;;
storage) cat <<'EOF'
STORAGE
  lsblk -f                 List disks, partitions, filesystems and labels
  blkid                    Show filesystem UUIDs and types
  findmnt                  Show mounted filesystems
  findmnt /PATH            Show which filesystem contains PATH
  df -hT                   Show filesystem capacity and type
  du -sh PATH              Show directory space usage
  cat /etc/fstab           Show persistent mount configuration
  btrfs filesystem usage / Show Btrfs space usage (Btrfs only)
EOF
;;
processes) cat <<'EOF'
PROCESSES
  ps aux              List running processes
  top                 Interactive process monitor; press q to quit
  htop                Friendlier process monitor, if installed
  pgrep NAME          Find process IDs by name
  kill PID            Ask a process to exit
  kill -TERM PID      Send a normal termination signal
EOF
;;
network) cat <<'EOF'
NETWORK
  ip address          Show network interfaces and addresses
  ip route            Show the routing table
  ping HOST           Test basic reachability; Ctrl+C stops it
  ss -tulpn           Show listening TCP/UDP sockets
  curl -I URL         Fetch response headers
  wget URL            Download a file
  resolvectl status   Show DNS resolver configuration
EOF
;;
packages) cat <<'EOF'
SYSTEM IMAGE AND PACKAGES
  bootc status                   Show the current, staged and rollback deployments
  rpm -q PACKAGE                 Check whether an RPM is included in the image
  dnf search KEYWORD             Search package metadata (read-only)
  dnf info PACKAGE               Show package details
  flatpak list                   List installed Flatpak applications
  lydmanage update               Stage an update to the configured bootc image
  lydmanage switch IMAGE         Switch to a different bootc image
  lydmanage rollback             Stage the previous deployment
  lydmanage status               Show bootc deployment status

Lyd Atomic system RPMs are supplied by the image. Update the image instead
of layering or removing system RPMs on the running deployment.
EOF
;;
flatpak) cat <<'EOF'
FLATPAK
  flatpak list                   List installed Flatpaks
  flatpak search NAME            Search configured remotes
  flatpak install flathub ID     Install an app from Flathub
  flatpak update                 Update Flatpak apps
  flatpak uninstall ID           Remove an app
  flatpak info ID                Show application details
  lydmanage flatpak save          Save installed app IDs to flatpak-apps.txt
  lydmanage flatpak load          Restore apps from flatpak-apps.txt via Flathub
  flatpak remote-ls flathub      List apps available on Flathub
EOF
;;
appimage) cat <<'EOF'
APPIMAGE
  chmod +x ./AppName.AppImage    Mark an AppImage as executable
  ./AppName.AppImage             Launch the AppImage from its folder
  file ./AppName.AppImage        Check that the download is an AppImage
  ./AppName.AppImage --appimage-extract
                                 Extract files when FUSE mounting is unavailable
  ./squashfs-root/AppRun         Run an extracted AppImage (from its extracted folder)

Lyd Atomic includes FUSE 2 compatibility libraries and FUSE 3 support for
many AppImages. AppImages bundle much of their own software, but some still
need extra host libraries or newer runtimes. Only run AppImages from sources
you trust. Keep the file in a user-writable location such as ~/Applications.
EOF
;;
archives) cat <<'EOF'
ARCHIVES
  tar -tf FILE.tar               List archive contents
  tar -xf FILE.tar               Extract an archive
  tar -czf backup.tar.gz DIR     Create a gzip-compressed tar archive
  tar -cJf backup.tar.xz DIR     Create an xz-compressed tar archive
  unzip FILE.zip                 Extract a ZIP archive
  zip -r FILE.zip DIR            Create a ZIP archive from a directory
EOF
;;
atomic) cat <<'EOF'
BOOTC / ATOMIC SYSTEM
  lydmanage update                    Stage an update from the current image source
  lydmanage switch <newImage>         Switch to another bootc image
  lydmanage status                    Show current, staged and rollback deployments
  lydmanage rollback                  Stage the previous deployment
  systemctl reboot                    Boot into the staged deployment
  lydmanage flatpak update            Update Flatpak applications
  lydmanage firmware update           Check for firmware updates

Image updates and switches are staged; they do not change the running system.
Reboot to activate the staged deployment. Keep a known-good deployment so
you can roll back if the new image does not work as expected.
EOF
;;
manage) cat <<'EOF'
LYD ATOMIC MANAGEMENT
  lydmanage switch workstation       Switch to the standard workstation
  lydmanage switch nvidia-gaming    Switch to the NVIDIA gaming workstation
  lydmanage switch server           Switch to the headless server
  lydmanage switch IMAGE            Switch to a full OCI image reference
  lydmanage update                  Update the current bootc image
  lydmanage status                  Show deployment status
  lydmanage rollback                Stage the previous deployment
  lydmanage flatpak update          Update Flatpak applications
  lydmanage firmware update         Update supported device firmware
  lydmanage updates auto enable     Enable weekly automatic updates
  lydmanage updates auto disable    Disable automatic updates
  lydmanage updates auto status     Show automatic update status
  lydmanage plasma save PROFILE    Save Plasma panels, widgets and layout
  lydmanage plasma load PROFILE    Restore a saved Plasma layout profile
  lydmanage flatpak save           Export installed Flatpak application IDs
  lydmanage flatpak load           Restore apps from flatpak-apps.txt via Flathub

The short command 'lydm' is an alias for 'lydmanage'.
EOF
;;
*) printf 'Unknown topic: %s\n\n' "$topic" >&2; show_index; exit 2 ;;
esac
