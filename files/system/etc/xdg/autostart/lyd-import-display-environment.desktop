[Desktop Entry]
Type=Application
Name=Lyd Desktop Environment Setup
Comment=Export the graphical display environment to D-Bus and systemd user services
Exec=/usr/bin/dbus-update-activation-environment --systemd DISPLAY
TryExec=/usr/bin/dbus-update-activation-environment
OnlyShowIn=KDE;
NoDisplay=true
X-KDE-autostart-phase=1
